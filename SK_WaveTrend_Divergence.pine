// [SK] WaveTrend Divergence v1.0
// Independent, open implementation. It does not read or copy any proprietary
// oscillator. Confirmed pivots appear after Right bars and do not move later.

//@version=6
indicator("[SK] WaveTrend Divergence v1.0", shorttitle = "SK WT DIV", overlay = false, max_lines_count = 120, max_labels_count = 120)

string groupOscillator = "WaveTrend"
int channelLength = input.int(10, "Channel length", minval = 2, group = groupOscillator)
int averageLength = input.int(21, "Average length", minval = 2, group = groupOscillator)
int signalLength = input.int(4, "Signal smoothing", minval = 1, group = groupOscillator)
float overbought = input.float(60.0, "Overbought", group = groupOscillator)
float oversold = input.float(-60.0, "Oversold", group = groupOscillator)

string groupDivergence = "Divergence"
int pivotLeft = input.int(5, "Pivot left bars", minval = 1, maxval = 25, group = groupDivergence)
int pivotRight = input.int(5, "Pivot right bars", minval = 1, maxval = 25, group = groupDivergence, tooltip = "A divergence is confirmed only after this many bars. The delay is intentional and prevents repainting.")
int minBarsApart = input.int(5, "Minimum bars between pivots", minval = 1, maxval = 100, group = groupDivergence)
int maxBarsApart = input.int(80, "Maximum bars between pivots", minval = 5, maxval = 500, group = groupDivergence)
bool showRegular = input.bool(true, "Show regular divergence", group = groupDivergence)
bool showHidden = input.bool(true, "Show hidden divergence", group = groupDivergence)
bool enableAlerts = input.bool(true, "Enable alert() events", group = groupDivergence, tooltip = "Create one TradingView alert using 'Any alert() function call'.")

float ap = hlc3
float esa = ta.ema(ap, channelLength)
float deviation = ta.ema(math.abs(ap - esa), channelLength)
float channelIndex = deviation == 0.0 ? 0.0 : (ap - esa) / (0.015 * deviation)
float wt1 = ta.ema(channelIndex, averageLength)
float wt2 = ta.sma(wt1, signalLength)

plot(wt1, "WaveTrend", color = color.rgb(41, 98, 255), linewidth = 2)
plot(wt2, "Signal", color = color.rgb(255, 152, 0), linewidth = 1)
hline(0.0, "Zero", color = color.new(color.gray, 65))
hline(overbought, "Overbought", color = color.new(color.red, 50), linestyle = hline.style_dashed)
hline(oversold, "Oversold", color = color.new(color.teal, 50), linestyle = hline.style_dashed)

float oscillatorLowPivot = ta.pivotlow(wt1, pivotLeft, pivotRight)
float oscillatorHighPivot = ta.pivothigh(wt1, pivotLeft, pivotRight)
bool confirmedLowPivot = barstate.isconfirmed and not na(oscillatorLowPivot)
bool confirmedHighPivot = barstate.isconfirmed and not na(oscillatorHighPivot)

var float previousLowPrice = na
var float previousLowOscillator = na
var int previousLowBar = na
var int previousLowTime = na
var float previousHighPrice = na
var float previousHighOscillator = na
var int previousHighBar = na
var int previousHighTime = na
var line[] divergenceLines = array.new_line()
var label[] divergenceLabels = array.new_label()

bool regularBullish = false
bool hiddenBullish = false
bool regularBearish = false
bool hiddenBearish = false
float eventPrice = na
float eventOscillator = na
int eventTime = na

f_store_line(line newLine, label newLabel) =>
    array.push(divergenceLines, newLine)
    array.push(divergenceLabels, newLabel)
    while array.size(divergenceLines) > 60
        line.delete(array.shift(divergenceLines))
    while array.size(divergenceLabels) > 60
        label.delete(array.shift(divergenceLabels))

if confirmedLowPivot
    int pivotBar = bar_index - pivotRight
    int pivotTime = time[pivotRight]
    float pivotPrice = low[pivotRight]
    float pivotOscillator = oscillatorLowPivot
    int separation = na(previousLowBar) ? 0 : pivotBar - previousLowBar
    bool separationOk = not na(previousLowBar) and separation >= minBarsApart and separation <= maxBarsApart
    regularBullish := separationOk and pivotPrice < previousLowPrice and pivotOscillator > previousLowOscillator
    hiddenBullish := separationOk and pivotPrice > previousLowPrice and pivotOscillator < previousLowOscillator
    if (regularBullish and showRegular) or (hiddenBullish and showHidden)
        bool regular = regularBullish
        color divergenceColor = regular ? color.rgb(0, 200, 170) : color.rgb(41, 182, 246)
        line divergenceLine = line.new(previousLowBar, previousLowOscillator, pivotBar, pivotOscillator, xloc = xloc.bar_index, color = divergenceColor, width = 2)
        label divergenceLabel = label.new(pivotBar, pivotOscillator, regular ? "REG BULL" : "HID BULL", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = color.new(divergenceColor, 78), textcolor = divergenceColor, size = size.tiny)
        f_store_line(divergenceLine, divergenceLabel)
        eventPrice := pivotPrice
        eventOscillator := pivotOscillator
        eventTime := pivotTime
    previousLowPrice := pivotPrice
    previousLowOscillator := pivotOscillator
    previousLowBar := pivotBar
    previousLowTime := pivotTime

if confirmedHighPivot
    int pivotBar = bar_index - pivotRight
    int pivotTime = time[pivotRight]
    float pivotPrice = high[pivotRight]
    float pivotOscillator = oscillatorHighPivot
    int separation = na(previousHighBar) ? 0 : pivotBar - previousHighBar
    bool separationOk = not na(previousHighBar) and separation >= minBarsApart and separation <= maxBarsApart
    regularBearish := separationOk and pivotPrice > previousHighPrice and pivotOscillator < previousHighOscillator
    hiddenBearish := separationOk and pivotPrice < previousHighPrice and pivotOscillator > previousHighOscillator
    if (regularBearish and showRegular) or (hiddenBearish and showHidden)
        bool regular = regularBearish
        color divergenceColor = regular ? color.rgb(239, 83, 80) : color.rgb(255, 152, 0)
        line divergenceLine = line.new(previousHighBar, previousHighOscillator, pivotBar, pivotOscillator, xloc = xloc.bar_index, color = divergenceColor, width = 2)
        label divergenceLabel = label.new(pivotBar, pivotOscillator, regular ? "REG BEAR" : "HID BEAR", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = color.new(divergenceColor, 78), textcolor = divergenceColor, size = size.tiny)
        f_store_line(divergenceLine, divergenceLabel)
        eventPrice := pivotPrice
        eventOscillator := pivotOscillator
        eventTime := pivotTime
    previousHighPrice := pivotPrice
    previousHighOscillator := pivotOscillator
    previousHighBar := pivotBar
    previousHighTime := pivotTime

bool visibleRegularBullish = regularBullish and showRegular
bool visibleHiddenBullish = hiddenBullish and showHidden
bool visibleRegularBearish = regularBearish and showRegular
bool visibleHiddenBearish = hiddenBearish and showHidden

alertcondition(visibleRegularBullish, "Regular bullish divergence", "Regular bullish WaveTrend divergence on {{exchange}}:{{ticker}} | TF {{interval}}")
alertcondition(visibleHiddenBullish, "Hidden bullish divergence", "Hidden bullish WaveTrend divergence on {{exchange}}:{{ticker}} | TF {{interval}}")
alertcondition(visibleRegularBearish, "Regular bearish divergence", "Regular bearish WaveTrend divergence on {{exchange}}:{{ticker}} | TF {{interval}}")
alertcondition(visibleHiddenBearish, "Hidden bearish divergence", "Hidden bearish WaveTrend divergence on {{exchange}}:{{ticker}} | TF {{interval}}")

if enableAlerts and (visibleRegularBullish or visibleHiddenBullish or visibleRegularBearish or visibleHiddenBearish)
    bool bullish = visibleRegularBullish or visibleHiddenBullish
    bool regular = visibleRegularBullish or visibleRegularBearish
    string payload = "{\"event\":\"divergence_confirmed\",\"symbol\":\"" + syminfo.tickerid + "\",\"timeframe\":\"" + timeframe.period + "\",\"direction\":\"" + (bullish ? "bullish" : "bearish") + "\",\"kind\":\"" + (regular ? "regular" : "hidden") + "\",\"price\":\"" + str.tostring(eventPrice, format.mintick) + "\",\"oscillator\":\"" + str.tostring(eventOscillator, "#.##") + "\",\"pivot_time\":\"" + str.tostring(eventTime) + "\"}"
    alert(payload, alert.freq_once_per_bar_close)
