// [SK] SFP + FVG / IFVG v5.3
// Radar aktualnych pul płynności, na których może powstać SFP.
// Poziom kandydujący pochodzi wyłącznie z potwierdzonego i jakościowego swingu.
// Sweep i powrót tworzą setup. Domyślny sygnał CONF powstaje dopiero po późniejszym
// zamknięciu ceny poza przeciwnym ekstremum świecy SFP (break struktury).
//
// Nie jest to rekomendacja inwestycyjna ani obietnica reakcji ceny.

//@version=6
indicator("[SK] SFP + FVG / IFVG v5.3", shorttitle = "SK SFP5.3", overlay = true, max_lines_count = 180, max_labels_count = 120, max_boxes_count = 30)

// ==================== PROSTE USTAWIENIA ====================
bool wlaczSfp = input.bool(true, "SFP — poziomy i potwierdzenia", group = "Włącz / wyłącz")
bool wlaczFvg = input.bool(true, "FVG / IFVG — najbliższe strefy z 1H", group = "Włącz / wyłącz")
bool wlaczDni = input.bool(true, "Dni tygodnia", group = "Włącz / wyłącz")
bool wlaczAlerty = input.bool(false, "Alerty", group = "Włącz / wyłącz", tooltip = "Włącza alerty SFP oraz FVG/IFVG. W TradingView wybierz warunek: Dowolne wywołanie funkcji alert().")

// Parametry zaawansowane są celowo stałe, żeby panel Inputs pozostał prosty.
string tryb = "Selektywny"
int swieceSwingu = 10
float minReakcjaAtr = 1.25
float laczenieAtr = 0.50
int okresAtr = 14
int maksWiek = 400
float maksOdlegloscAtr = 15.0
int ileNadCena = wlaczSfp ? 2 : 0
int ilePodCena = wlaczSfp ? 2 : 0
bool pokazNazwy = wlaczSfp
color kolorHigh = color.rgb(41, 98, 255)
color kolorLow = color.rgb(38, 166, 154)
bool pokazDotkniete = wlaczSfp
int pamiecDotknietych = 12
float usunDotknietyPoAtr = 5.0
int ileDotknietychNaStrone = 2

bool calyKorpus = true
float minSweepAtr = 0.10
float maxSweepAtr = 1.00
float minZakresSetupAtr = 1.20
string sposobPotwierdzenia = "Break struktury"
int oknoPotwierdzenia = 3
float buforUniewaznieniaAtr = 0.10
bool filtrWolumenu = false
int okresWolumenu = 20
float mnoznikWolumenu = 1.20
bool pokazOstatniSygnal = wlaczSfp
int waznoscSygnalu = 72
bool pokazPanel = false
color kolorShort = color.rgb(239, 83, 80)
color kolorLong = color.rgb(38, 166, 154)

float minWielkoscFvgAtr = 0.12
int maksWiekStrefFvg = 300
int maksWiekStrefIfvg = 72
int ileFvgNaStrone = 3
color kolorStrefyFvg = color.rgb(255, 193, 7)
int przezroczystoscFvg = 72

bool pokazDniTygodnia = wlaczDni
bool pokazSeparatoryDni = wlaczDni
string strefaCzasowaDni = "Europe/Warsaw"
int przezroczystoscDni = 45
int przezroczystoscSeparatorow = 55
color kolorNazwDni = color.silver
color kolorSeparatorow = color.white

bool alertujDotknieciaSfp = wlaczAlerty and wlaczSfp
bool alertujPotwierdzeniaSfp = wlaczAlerty and wlaczSfp
bool alertujNoweFvg = wlaczAlerty and wlaczFvg
bool alertujNoweIfvg = wlaczAlerty and wlaczFvg

// ==================== PAMIĘĆ JAKOŚCIOWYCH SWINGÓW ====================
var float[] cenyHigh = array.new_float()
var int[] baryHigh = array.new_int()
var float[] jakoscHigh = array.new_float()
var float[] cenyLow = array.new_float()
var int[] baryLow = array.new_int()
var float[] jakoscLow = array.new_float()
var float[] dotknieteHigh = array.new_float()
var int[] dotknieteHighPivotBar = array.new_int()
var int[] dotknieteHighBar = array.new_int()
var float[] dotknieteLow = array.new_float()
var int[] dotknieteLowPivotBar = array.new_int()
var int[] dotknieteLowBar = array.new_int()

f_dodaj_lub_polacz(float[] ceny, int[] bary, float[] jakosci, float nowaCena, int nowyBar, float nowaJakosc, float progLaczenia) =>
    int indeks = -1
    if array.size(ceny) > 0
        for i = 0 to array.size(ceny) - 1
            if math.abs(nowaCena - array.get(ceny, i)) <= progLaczenia
                indeks := i
                break
    if indeks >= 0
        float staraJakosc = array.get(jakosci, indeks)
        int staryBar = array.get(bary, indeks)
        if nowaJakosc > staraJakosc or (nowaJakosc == staraJakosc and nowyBar > staryBar)
            array.set(ceny, indeks, nowaCena)
            array.set(bary, indeks, nowyBar)
            array.set(jakosci, indeks, nowaJakosc)
    else
        array.push(ceny, nowaCena)
        array.push(bary, nowyBar)
        array.push(jakosci, nowaJakosc)
    while array.size(ceny) > 100
        array.shift(ceny)
        array.shift(bary)
        array.shift(jakosci)

f_zapamietaj_dotkniety(float[] ceny, int[] baryPivot, int[] baryDotkniecia, float cena, int pivotBar) =>
    array.push(ceny, cena)
    array.push(baryPivot, pivotBar)
    array.push(baryDotkniecia, bar_index)
    while array.size(ceny) > 20
        array.shift(ceny)
        array.shift(baryPivot)
        array.shift(baryDotkniecia)

float atr = ta.atr(okresAtr)
float pivotHigh = ta.pivothigh(high, swieceSwingu, swieceSwingu)
float pivotLow = ta.pivotlow(low, swieceSwingu, swieceSwingu)
float atrSwingu = nz(atr[swieceSwingu], atr)
float progLaczenia = math.max(syminfo.mintick, atrSwingu * laczenieAtr)
float najnizszyPoHigh = ta.lowest(low, swieceSwingu + 1)
float najwyzszyPoLow = ta.highest(high, swieceSwingu + 1)

if not na(pivotHigh) and atrSwingu > 0
    float reakcja = (pivotHigh - najnizszyPoHigh) / atrSwingu
    if reakcja >= minReakcjaAtr
        f_dodaj_lub_polacz(cenyHigh, baryHigh, jakoscHigh, pivotHigh, bar_index - swieceSwingu, reakcja, progLaczenia)

if not na(pivotLow) and atrSwingu > 0
    float reakcja = (najwyzszyPoLow - pivotLow) / atrSwingu
    if reakcja >= minReakcjaAtr
        f_dodaj_lub_polacz(cenyLow, baryLow, jakoscLow, pivotLow, bar_index - swieceSwingu, reakcja, progLaczenia)

// Pierwsze dotknięcie jest wykrywane na otwartej świecy, zanim potwierdzona świeca
// przeniesie zużyty poziom z aktywnego radaru do pamięci poziomów dotkniętych.
// Dzięki temu alert nie czeka na zamknięcie świecy.
float cenaOdniesieniaRadaru = barstate.isconfirmed ? close : nz(close[1], close)
float limitOdleglosciRadaru = atr * maksOdlegloscAtr
bool dotkniecieHighTeraz = false
float dotkniecieHighPoziom = na
float dotkniecieHighOdleglosc = 1e20
bool dotkniecieLowTeraz = false
float dotkniecieLowPoziom = na
float dotkniecieLowOdleglosc = 1e20

if array.size(cenyHigh) > 0
    for i = 0 to array.size(cenyHigh) - 1
        float poziom = array.get(cenyHigh, i)
        int pivotBar = array.get(baryHigh, i)
        float odleglosc = math.abs(cenaOdniesieniaRadaru - poziom)
        bool aktywny = bar_index > pivotBar and bar_index - pivotBar <= maksWiek and odleglosc <= limitOdleglosciRadaru
        if aktywny and high >= poziom and odleglosc < dotkniecieHighOdleglosc
            dotkniecieHighTeraz := true
            dotkniecieHighPoziom := poziom
            dotkniecieHighOdleglosc := odleglosc

if array.size(cenyLow) > 0
    for i = 0 to array.size(cenyLow) - 1
        float poziom = array.get(cenyLow, i)
        int pivotBar = array.get(baryLow, i)
        float odleglosc = math.abs(cenaOdniesieniaRadaru - poziom)
        bool aktywny = bar_index > pivotBar and bar_index - pivotBar <= maksWiek and odleglosc <= limitOdleglosciRadaru
        if aktywny and low <= poziom and odleglosc < dotkniecieLowOdleglosc
            dotkniecieLowTeraz := true
            dotkniecieLowPoziom := poziom
            dotkniecieLowOdleglosc := odleglosc

bool dotkniecieShortAlert = dotkniecieHighTeraz and (not dotkniecieLowTeraz or dotkniecieHighOdleglosc <= dotkniecieLowOdleglosc)
bool dotkniecieLongAlert = dotkniecieLowTeraz and not dotkniecieShortAlert

// ==================== SWEEP = SETUP, BREAK STRUKTURY = CONF ====================
float sredniWolumen = ta.sma(volume, okresWolumenu)
bool wolumenOk = not filtrWolumenu or (not na(volume) and not na(sredniWolumen) and volume >= sredniWolumen * mnoznikWolumenu)
float minSweep = atr * minSweepAtr
float maxSweep = maxSweepAtr == 0.0 ? 1e20 : atr * maxSweepAtr

bool bearishSetup = false
float bearishSetupPoziom = na
int bearishSetupPivotBar = na
float bearishSetupWybicie = na
bool bullishSetup = false
float bullishSetupPoziom = na
int bullishSetupPivotBar = na
float bullishSetupWybicie = na

if barstate.isconfirmed and array.size(cenyHigh) > 0
    for i = array.size(cenyHigh) - 1 to 0
        float poziom = array.get(cenyHigh, i)
        int pivotBar = array.get(baryHigh, i)
        bool wygasl = bar_index - pivotBar > maksWiek
        bool naruszony = high >= poziom
        if wygasl or naruszony
            if naruszony
                if pokazDotkniete
                    f_zapamietaj_dotkniety(dotknieteHigh, dotknieteHighPivotBar, dotknieteHighBar, poziom, pivotBar)
                float wybicie = high - poziom
                bool zakresOk = minZakresSetupAtr == 0.0 or high - low >= atr * minZakresSetupAtr
                bool setup = close < poziom and (not calyKorpus or open < poziom) and wybicie >= minSweep and wybicie <= maxSweep and wolumenOk and zakresOk
                if setup and (not bearishSetup or poziom < bearishSetupPoziom)
                    bearishSetup := true
                    bearishSetupPoziom := poziom
                    bearishSetupPivotBar := pivotBar
                    bearishSetupWybicie := wybicie
            array.remove(cenyHigh, i)
            array.remove(baryHigh, i)
            array.remove(jakoscHigh, i)

if barstate.isconfirmed and array.size(cenyLow) > 0
    for i = array.size(cenyLow) - 1 to 0
        float poziom = array.get(cenyLow, i)
        int pivotBar = array.get(baryLow, i)
        bool wygasl = bar_index - pivotBar > maksWiek
        bool naruszony = low <= poziom
        if wygasl or naruszony
            if naruszony
                if pokazDotkniete
                    f_zapamietaj_dotkniety(dotknieteLow, dotknieteLowPivotBar, dotknieteLowBar, poziom, pivotBar)
                float wybicie = poziom - low
                bool zakresOk = minZakresSetupAtr == 0.0 or high - low >= atr * minZakresSetupAtr
                bool setup = close > poziom and (not calyKorpus or open > poziom) and wybicie >= minSweep and wybicie <= maxSweep and wolumenOk and zakresOk
                if setup and (not bullishSetup or poziom > bullishSetupPoziom)
                    bullishSetup := true
                    bullishSetupPoziom := poziom
                    bullishSetupPivotBar := pivotBar
                    bullishSetupWybicie := wybicie
            array.remove(cenyLow, i)
            array.remove(baryLow, i)
            array.remove(jakoscLow, i)

// Dotknięty poziom jest już zużyty jako pula płynności, więc nie wraca do aktywnego
// radaru. Pozostaje jednak na wykresie przez ustawioną liczbę świec albo do chwili,
// gdy cena oddali się od niego o zbyt wiele ATR.
float limitDotknietych = atr * usunDotknietyPoAtr
if barstate.isconfirmed and array.size(dotknieteHigh) > 0
    for i = array.size(dotknieteHigh) - 1 to 0
        bool zaStary = bar_index - array.get(dotknieteHighBar, i) > pamiecDotknietych
        bool zaDaleko = math.abs(close - array.get(dotknieteHigh, i)) > limitDotknietych
        if not pokazDotkniete or zaStary or zaDaleko
            array.remove(dotknieteHigh, i)
            array.remove(dotknieteHighPivotBar, i)
            array.remove(dotknieteHighBar, i)

if barstate.isconfirmed and array.size(dotknieteLow) > 0
    for i = array.size(dotknieteLow) - 1 to 0
        bool zaStary = bar_index - array.get(dotknieteLowBar, i) > pamiecDotknietych
        bool zaDaleko = math.abs(close - array.get(dotknieteLow, i)) > limitDotknietych
        if not pokazDotkniete or zaStary or zaDaleko
            array.remove(dotknieteLow, i)
            array.remove(dotknieteLowPivotBar, i)
            array.remove(dotknieteLowBar, i)

var bool oczekujeBear = false
var float oczekujeBearPoziom = na
var int oczekujeBearPivotBar = na
var float oczekujeBearHigh = na
var float oczekujeBearLow = na
var float oczekujeBearAtr = na
var float oczekujeBearWybicie = na
var int oczekujeBearBar = na
var bool oczekujeBull = false
var float oczekujeBullPoziom = na
var int oczekujeBullPivotBar = na
var float oczekujeBullHigh = na
var float oczekujeBullLow = na
var float oczekujeBullAtr = na
var float oczekujeBullWybicie = na
var int oczekujeBullBar = na

bool bearishSfp = false
float bearishPoziom = na
int bearishPivotBar = na
float bearishWybicie = na
bool bullishSfp = false
float bullishPoziom = na
int bullishPivotBar = na
float bullishWybicie = na

if barstate.isconfirmed and sposobPotwierdzenia == "Break struktury"
    if oczekujeBear and bar_index > oczekujeBearBar
        bool uniewazniony = high > oczekujeBearHigh + oczekujeBearAtr * buforUniewaznieniaAtr
        bool wygasl = bar_index - oczekujeBearBar > oknoPotwierdzenia
        bool potwierdzony = close < oczekujeBearLow
        if uniewazniony or wygasl
            oczekujeBear := false
        else if potwierdzony
            bearishSfp := true
            bearishPoziom := oczekujeBearPoziom
            bearishPivotBar := oczekujeBearPivotBar
            bearishWybicie := oczekujeBearWybicie
            oczekujeBear := false
    if oczekujeBull and bar_index > oczekujeBullBar
        bool uniewazniony = low < oczekujeBullLow - oczekujeBullAtr * buforUniewaznieniaAtr
        bool wygasl = bar_index - oczekujeBullBar > oknoPotwierdzenia
        bool potwierdzony = close > oczekujeBullHigh
        if uniewazniony or wygasl
            oczekujeBull := false
        else if potwierdzony
            bullishSfp := true
            bullishPoziom := oczekujeBullPoziom
            bullishPivotBar := oczekujeBullPivotBar
            bullishWybicie := oczekujeBullWybicie
            oczekujeBull := false

if bearishSetup
    if sposobPotwierdzenia == "Sam powrót świecy"
        bearishSfp := true
        bearishPoziom := bearishSetupPoziom
        bearishPivotBar := bearishSetupPivotBar
        bearishWybicie := bearishSetupWybicie
    else
        oczekujeBear := true
        oczekujeBearPoziom := bearishSetupPoziom
        oczekujeBearPivotBar := bearishSetupPivotBar
        oczekujeBearHigh := high
        oczekujeBearLow := low
        oczekujeBearAtr := atr
        oczekujeBearWybicie := bearishSetupWybicie
        oczekujeBearBar := bar_index

if bullishSetup
    if sposobPotwierdzenia == "Sam powrót świecy"
        bullishSfp := true
        bullishPoziom := bullishSetupPoziom
        bullishPivotBar := bullishSetupPivotBar
        bullishWybicie := bullishSetupWybicie
    else
        oczekujeBull := true
        oczekujeBullPoziom := bullishSetupPoziom
        oczekujeBullPivotBar := bullishSetupPivotBar
        oczekujeBullHigh := high
        oczekujeBullLow := low
        oczekujeBullAtr := atr
        oczekujeBullWybicie := bullishSetupWybicie
        oczekujeBullBar := bar_index

// ==================== WYBÓR TYLKO NAJBLIŻSZYCH POZIOMÓW ====================
var float[] wybraneHigh = array.new_float()
var int[] wybraneHighBar = array.new_int()
var float[] wybraneLow = array.new_float()
var int[] wybraneLowBar = array.new_int()
array.clear(wybraneHigh)
array.clear(wybraneHighBar)
array.clear(wybraneLow)
array.clear(wybraneLowBar)

float limitOdleglosci = limitOdleglosciRadaru

if ileNadCena > 0 and array.size(cenyHigh) > 0
    for i = 0 to array.size(cenyHigh) - 1
        float poziom = array.get(cenyHigh, i)
        if poziom > cenaOdniesieniaRadaru and poziom - cenaOdniesieniaRadaru <= limitOdleglosci
            int pozycja = array.size(wybraneHigh)
            if array.size(wybraneHigh) > 0
                for j = 0 to array.size(wybraneHigh) - 1
                    if poziom < array.get(wybraneHigh, j)
                        pozycja := j
                        break
            array.insert(wybraneHigh, pozycja, poziom)
            array.insert(wybraneHighBar, pozycja, array.get(baryHigh, i))
            while array.size(wybraneHigh) > ileNadCena
                array.pop(wybraneHigh)
                array.pop(wybraneHighBar)

if ilePodCena > 0 and array.size(cenyLow) > 0
    for i = 0 to array.size(cenyLow) - 1
        float poziom = array.get(cenyLow, i)
        if poziom < cenaOdniesieniaRadaru and cenaOdniesieniaRadaru - poziom <= limitOdleglosci
            int pozycja = array.size(wybraneLow)
            if array.size(wybraneLow) > 0
                for j = 0 to array.size(wybraneLow) - 1
                    if poziom > array.get(wybraneLow, j)
                        pozycja := j
                        break
            array.insert(wybraneLow, pozycja, poziom)
            array.insert(wybraneLowBar, pozycja, array.get(baryLow, i))
            while array.size(wybraneLow) > ilePodCena
                array.pop(wybraneLow)
                array.pop(wybraneLowBar)

// ==================== CZYSTE RYSOWANIE RADARU ====================
var line[] linieRadaru = array.new_line()
var label[] etykietyRadaru = array.new_label()

if barstate.islast
    if array.size(linieRadaru) > 0
        for i = array.size(linieRadaru) - 1 to 0
            line.delete(array.get(linieRadaru, i))
    if array.size(etykietyRadaru) > 0
        for i = array.size(etykietyRadaru) - 1 to 0
            label.delete(array.get(etykietyRadaru, i))
    array.clear(linieRadaru)
    array.clear(etykietyRadaru)

    if array.size(wybraneHigh) > 0
        for i = 0 to array.size(wybraneHigh) - 1
            float poziom = array.get(wybraneHigh, i)
            int pivotBar = array.get(wybraneHighBar, i)
            int przezroczystosc = i == 0 ? 0 : 25
            bool dotknietyNaOtwartej = not barstate.isconfirmed and high >= poziom
            line ln = line.new(pivotBar, poziom, bar_index, poziom, xloc = xloc.bar_index, extend = extend.right, color = color.new(kolorHigh, dotknietyNaOtwartej ? 48 : przezroczystosc), style = dotknietyNaOtwartej ? line.style_dashed : line.style_solid, width = dotknietyNaOtwartej ? 1 : i == 0 ? 2 : 1, force_overlay = true)
            array.push(linieRadaru, ln)
            if pokazNazwy
                string tekst = dotknietyNaOtwartej ? "DOTKNIĘTY HIGH  " : "SFP HIGH " + str.tostring(i + 1) + "  "
                label lb = label.new(bar_index + 1, poziom, tekst + str.tostring(poziom, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(kolorHigh, dotknietyNaOtwartej ? 62 : 15), textcolor = color.white, size = size.tiny, force_overlay = true)
                array.push(etykietyRadaru, lb)

    if array.size(wybraneLow) > 0
        for i = 0 to array.size(wybraneLow) - 1
            float poziom = array.get(wybraneLow, i)
            int pivotBar = array.get(wybraneLowBar, i)
            int przezroczystosc = i == 0 ? 0 : 25
            bool dotknietyNaOtwartej = not barstate.isconfirmed and low <= poziom
            line ln = line.new(pivotBar, poziom, bar_index, poziom, xloc = xloc.bar_index, extend = extend.right, color = color.new(kolorLow, dotknietyNaOtwartej ? 48 : przezroczystosc), style = dotknietyNaOtwartej ? line.style_dashed : line.style_solid, width = dotknietyNaOtwartej ? 1 : i == 0 ? 2 : 1, force_overlay = true)
            array.push(linieRadaru, ln)
            if pokazNazwy
                string tekst = dotknietyNaOtwartej ? "DOTKNIĘTY LOW  " : "SFP LOW " + str.tostring(i + 1) + "  "
                label lb = label.new(bar_index + 1, poziom, tekst + str.tostring(poziom, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(kolorLow, dotknietyNaOtwartej ? 62 : 15), textcolor = color.white, size = size.tiny, force_overlay = true)
                array.push(etykietyRadaru, lb)

    if pokazDotkniete and ileDotknietychNaStrone > 0 and array.size(dotknieteHigh) > 0
        int narysowaneHigh = 0
        for i = array.size(dotknieteHigh) - 1 to 0
            if narysowaneHigh < ileDotknietychNaStrone
                float poziom = array.get(dotknieteHigh, i)
                int pivotBar = array.get(dotknieteHighPivotBar, i)
                line ln = line.new(pivotBar, poziom, bar_index, poziom, xloc = xloc.bar_index, extend = extend.right, color = color.new(kolorHigh, 58), style = line.style_dashed, width = 1, force_overlay = true)
                array.push(linieRadaru, ln)
                if pokazNazwy
                    label lb = label.new(bar_index + 1, poziom, "DOTKNIĘTY HIGH  " + str.tostring(poziom, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(kolorHigh, 62), textcolor = color.white, size = size.tiny, force_overlay = true)
                    array.push(etykietyRadaru, lb)
                narysowaneHigh += 1

    if pokazDotkniete and ileDotknietychNaStrone > 0 and array.size(dotknieteLow) > 0
        int narysowaneLow = 0
        for i = array.size(dotknieteLow) - 1 to 0
            if narysowaneLow < ileDotknietychNaStrone
                float poziom = array.get(dotknieteLow, i)
                int pivotBar = array.get(dotknieteLowPivotBar, i)
                line ln = line.new(pivotBar, poziom, bar_index, poziom, xloc = xloc.bar_index, extend = extend.right, color = color.new(kolorLow, 58), style = line.style_dashed, width = 1, force_overlay = true)
                array.push(linieRadaru, ln)
                if pokazNazwy
                    label lb = label.new(bar_index + 1, poziom, "DOTKNIĘTY LOW  " + str.tostring(poziom, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(kolorLow, 62), textcolor = color.white, size = size.tiny, force_overlay = true)
                    array.push(etykietyRadaru, lb)
                narysowaneLow += 1

// ==================== FVG / IFVG 1H — NAJBLIŻSZE NAD I POD CENĄ ====================
// Dane pochodzą wyłącznie z zamkniętych świec godzinowych. W klasycznym
// układzie trzech świec [3] jest świecą pierwszą, a [1] trzecią i już
// potwierdzoną. Dzięki temu granice strefy nie zmieniają się po jej utworzeniu.
[h1Czas, h1High, h1Low, h1Close, h1HighPierwszej, h1LowPierwszej, h1Atr] = request.security(syminfo.tickerid, "60", [time[1], high[1], low[1], close[1], high[3], low[3], ta.atr(14)[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
int zmianaH1Czas = ta.change(h1Czas)
bool nowaZamknietaGodzina = not na(h1Czas) and zmianaH1Czas != 0

var float[] goryStref = array.new_float()
var float[] dolyStref = array.new_float()
var int[] kierunkiStref = array.new_int()       // 1 = wzrostowa, -1 = spadkowa
var bool[] strefyOdwrocone = array.new_bool()   // false = FVG, true = IFVG
var int[] czasyStartuStref = array.new_int()
var int[] czasyInwersjiStref = array.new_int()
var box[] narysowaneStrefyFvg = array.new_box()

bool noweBullFvg = false
bool noweBearFvg = false
bool noweBullIfvg = false
bool noweBearIfvg = false
float noweFvgGora = na
float noweFvgDol = na
float noweIfvgGora = na
float noweIfvgDol = na

if not wlaczFvg
    array.clear(goryStref)
    array.clear(dolyStref)
    array.clear(kierunkiStref)
    array.clear(strefyOdwrocone)
    array.clear(czasyStartuStref)
    array.clear(czasyInwersjiStref)

if wlaczFvg and nowaZamknietaGodzina
    // Najpierw aktualizujemy wcześniejsze strefy ostatnią zamkniętą świecą 1H.
    if array.size(goryStref) > 0
        for i = array.size(goryStref) - 1 to 0
            float gora = array.get(goryStref, i)
            float dol = array.get(dolyStref, i)
            int kierunek = array.get(kierunkiStref, i)
            bool odwrocona = array.get(strefyOdwrocone, i)
            int czasStartu = array.get(czasyStartuStref, i)
            int czasInwersji = array.get(czasyInwersjiStref, i)
            int czasWieku = odwrocona and not na(czasInwersji) ? czasInwersji : czasStartu
            int limitWieku = odwrocona ? maksWiekStrefIfvg : maksWiekStrefFvg
            bool zaStara = h1Czas - czasWieku > limitWieku * 60 * 60 * 1000
            bool usunStrefe = zaStara

            if not usunStrefe and not odwrocona
                bool inwersja = (kierunek == 1 and h1Close < dol) or (kierunek == -1 and h1Close > gora)
                bool pelneWypelnienie = (kierunek == 1 and h1Low <= dol) or (kierunek == -1 and h1High >= gora)
                if inwersja
                    int nowyKierunek = -kierunek
                    array.set(kierunkiStref, i, nowyKierunek)
                    array.set(strefyOdwrocone, i, true)
                    array.set(czasyInwersjiStref, i, h1Czas)
                    noweBullIfvg := nowyKierunek == 1
                    noweBearIfvg := nowyKierunek == -1
                    noweIfvgGora := gora
                    noweIfvgDol := dol
                else if pelneWypelnienie
                    usunStrefe := true
            else if not usunStrefe
                bool wypelnioneIfvg = (kierunek == 1 and h1Low <= dol) or (kierunek == -1 and h1High >= gora)
                if wypelnioneIfvg
                    usunStrefe := true

            if usunStrefe
                array.remove(goryStref, i)
                array.remove(dolyStref, i)
                array.remove(kierunkiStref, i)
                array.remove(strefyOdwrocone, i)
                array.remove(czasyStartuStref, i)
                array.remove(czasyInwersjiStref, i)

    // Nowe klasyczne FVG powstaje po zamknięciu trzeciej świecy 1H.
    bool kandydatBullFvg = not na(h1Atr) and h1Atr > 0 and h1Low > h1HighPierwszej and h1Low - h1HighPierwszej >= h1Atr * minWielkoscFvgAtr
    bool kandydatBearFvg = not na(h1Atr) and h1Atr > 0 and h1High < h1LowPierwszej and h1LowPierwszej - h1High >= h1Atr * minWielkoscFvgAtr
    if kandydatBullFvg or kandydatBearFvg
        bool bull = kandydatBullFvg
        float gora = bull ? h1Low : h1LowPierwszej
        float dol = bull ? h1HighPierwszej : h1High
        array.push(goryStref, gora)
        array.push(dolyStref, dol)
        array.push(kierunkiStref, bull ? 1 : -1)
        array.push(strefyOdwrocone, false)
        array.push(czasyStartuStref, h1Czas)
        array.push(czasyInwersjiStref, int(na))
        noweBullFvg := bull
        noweBearFvg := not bull
        noweFvgGora := gora
        noweFvgDol := dol

    while array.size(goryStref) > 60
        array.shift(goryStref)
        array.shift(dolyStref)
        array.shift(kierunkiStref)
        array.shift(strefyOdwrocone)
        array.shift(czasyStartuStref)
        array.shift(czasyInwersjiStref)

// Strefy wybieramy według ich położenia względem bieżącej ceny, a nie według
// kierunku. Dzięki temu radar może równocześnie pokazać do trzech najbliższych
// luk nad ceną i do trzech pod ceną. Strefa aktualnie przecinana przez cenę
// trafia na stronę zgodną z jej aktywnym kierunkiem reakcji.
int[] wybraneStrefyNad = array.new_int()
int[] wybraneStrefyPod = array.new_int()
if wlaczFvg and array.size(goryStref) > 0
    for slot = 0 to ileFvgNaStrone - 1
        int najlepszyIndeksNad = -1
        float najlepszaOdlegloscNad = 1e20
        int najnowszyCzasNad = 0
        for i = 0 to array.size(goryStref) - 1
            float gora = array.get(goryStref, i)
            float dol = array.get(dolyStref, i)
            int kierunek = array.get(kierunkiStref, i)
            bool przecinaCene = close >= dol and close <= gora
            bool jestNadCena = dol > close or (przecinaCene and kierunek == -1)
            float odleglosc = jestNadCena ? math.max(dol - close, 0.0) : 1e20
            int czasStartu = array.get(czasyStartuStref, i)
            bool lepsza = odleglosc < najlepszaOdlegloscNad or (odleglosc == najlepszaOdlegloscNad and czasStartu > najnowszyCzasNad)
            if jestNadCena and not array.includes(wybraneStrefyNad, i) and lepsza
                najlepszyIndeksNad := i
                najlepszaOdlegloscNad := odleglosc
                najnowszyCzasNad := czasStartu
        if najlepszyIndeksNad >= 0
            array.push(wybraneStrefyNad, najlepszyIndeksNad)

    for slot = 0 to ileFvgNaStrone - 1
        int najlepszyIndeksPod = -1
        float najlepszaOdlegloscPod = 1e20
        int najnowszyCzasPod = 0
        for i = 0 to array.size(goryStref) - 1
            float gora = array.get(goryStref, i)
            float dol = array.get(dolyStref, i)
            int kierunek = array.get(kierunkiStref, i)
            bool przecinaCene = close >= dol and close <= gora
            bool jestPodCena = gora < close or (przecinaCene and kierunek == 1)
            float odleglosc = jestPodCena ? math.max(close - gora, 0.0) : 1e20
            int czasStartu = array.get(czasyStartuStref, i)
            bool lepsza = odleglosc < najlepszaOdlegloscPod or (odleglosc == najlepszaOdlegloscPod and czasStartu > najnowszyCzasPod)
            if jestPodCena and not array.includes(wybraneStrefyPod, i) and lepsza
                najlepszyIndeksPod := i
                najlepszaOdlegloscPod := odleglosc
                najnowszyCzasPod := czasStartu
        if najlepszyIndeksPod >= 0
            array.push(wybraneStrefyPod, najlepszyIndeksPod)

if barstate.islast
    if array.size(narysowaneStrefyFvg) > 0
        for i = array.size(narysowaneStrefyFvg) - 1 to 0
            box.delete(array.get(narysowaneStrefyFvg, i))
    array.clear(narysowaneStrefyFvg)

    if wlaczFvg and array.size(wybraneStrefyNad) > 0
        for i = 0 to array.size(wybraneStrefyNad) - 1
            int indeks = array.get(wybraneStrefyNad, i)
            float gora = array.get(goryStref, indeks)
            float dol = array.get(dolyStref, indeks)
            int lewo = array.get(czasyStartuStref, indeks)
            string tekst = array.get(strefyOdwrocone, indeks) ? "IFVG 1H" : "FVG 1H"
            box nowyBox = box.new(left = lewo, top = gora, right = time_close, bottom = dol, xloc = xloc.bar_time, extend = extend.none, border_color = color.new(kolorStrefyFvg, 100), border_width = 0, bgcolor = color.new(kolorStrefyFvg, przezroczystoscFvg), text = tekst, text_color = color.white, text_size = size.small, text_halign = text.align_center, text_valign = text.align_center)
            array.push(narysowaneStrefyFvg, nowyBox)

    if wlaczFvg and array.size(wybraneStrefyPod) > 0
        for i = 0 to array.size(wybraneStrefyPod) - 1
            int indeks = array.get(wybraneStrefyPod, i)
            float gora = array.get(goryStref, indeks)
            float dol = array.get(dolyStref, indeks)
            int lewo = array.get(czasyStartuStref, indeks)
            string tekst = array.get(strefyOdwrocone, indeks) ? "IFVG 1H" : "FVG 1H"
            box nowyBox = box.new(left = lewo, top = gora, right = time_close, bottom = dol, xloc = xloc.bar_time, extend = extend.none, border_color = color.new(kolorStrefyFvg, 100), border_width = 0, bgcolor = color.new(kolorStrefyFvg, przezroczystoscFvg), text = tekst, text_color = color.white, text_size = size.small, text_halign = text.align_center, text_valign = text.align_center)
            array.push(narysowaneStrefyFvg, nowyBox)

// ==================== DNI TYGODNIA (CZAS WARSZAWSKI) ====================
int czasDniaWarszawa = time("D", "0000-2359:1234567", strefaCzasowaDni)
int zmianaDniaWarszawa = ta.change(czasDniaWarszawa)
bool poczatekDniaWarszawa = not na(czasDniaWarszawa) and zmianaDniaWarszawa != 0
int dzienWarszawa = dayofweek(time, strefaCzasowaDni)
int godzinaWarszawa = hour(time, strefaCzasowaDni)
int godzinaPoprzedniejSwiecyWarszawa = hour(time[1], strefaCzasowaDni)
// Nazwa trafia na pierwszą świecę po lokalnym południu, czyli w środek
// odcinka wyznaczonego przez dwie kolejne północe. Działa także wtedy,
// gdy wybrany interwał nie ma świecy otwieranej dokładnie o 12:00.
bool srodekDniaWarszawa = not na(czasDniaWarszawa) and godzinaWarszawa >= 12 and (na(czasDniaWarszawa[1]) or czasDniaWarszawa != czasDniaWarszawa[1] or godzinaPoprzedniejSwiecyWarszawa < 12)

// Cienki glif bez tła etykiety ma wysokość pojedynczej litery i leży na tej samej dolnej linii.
plotchar(pokazDniTygodnia and pokazSeparatoryDni and poczatekDniaWarszawa, title = "Początek dnia", char = "l", location = location.bottom, color = color.new(kolorSeparatorow, przezroczystoscSeparatorow), size = size.tiny, display = display.pane, force_overlay = true)

color tloNazwyDnia = color.new(kolorNazwDni, 100)
color tekstNazwyDnia = color.new(kolorNazwDni, przezroczystoscDni)
plotshape(pokazDniTygodnia and srodekDniaWarszawa and dzienWarszawa == dayofweek.monday, title = "Poniedziałek", style = shape.labelup, location = location.bottom, color = tloNazwyDnia, text = "Poniedziałek", textcolor = tekstNazwyDnia, size = size.tiny, display = display.pane, force_overlay = true)
plotshape(pokazDniTygodnia and srodekDniaWarszawa and dzienWarszawa == dayofweek.tuesday, title = "Wtorek", style = shape.labelup, location = location.bottom, color = tloNazwyDnia, text = "Wtorek", textcolor = tekstNazwyDnia, size = size.tiny, display = display.pane, force_overlay = true)
plotshape(pokazDniTygodnia and srodekDniaWarszawa and dzienWarszawa == dayofweek.wednesday, title = "Środa", style = shape.labelup, location = location.bottom, color = tloNazwyDnia, text = "Środa", textcolor = tekstNazwyDnia, size = size.tiny, display = display.pane, force_overlay = true)
plotshape(pokazDniTygodnia and srodekDniaWarszawa and dzienWarszawa == dayofweek.thursday, title = "Czwartek", style = shape.labelup, location = location.bottom, color = tloNazwyDnia, text = "Czwartek", textcolor = tekstNazwyDnia, size = size.tiny, display = display.pane, force_overlay = true)
plotshape(pokazDniTygodnia and srodekDniaWarszawa and dzienWarszawa == dayofweek.friday, title = "Piątek", style = shape.labelup, location = location.bottom, color = tloNazwyDnia, text = "Piątek", textcolor = tekstNazwyDnia, size = size.tiny, display = display.pane, force_overlay = true)
plotshape(pokazDniTygodnia and srodekDniaWarszawa and dzienWarszawa == dayofweek.saturday, title = "Sobota", style = shape.labelup, location = location.bottom, color = tloNazwyDnia, text = "Sobota", textcolor = tekstNazwyDnia, size = size.tiny, display = display.pane, force_overlay = true)
plotshape(pokazDniTygodnia and srodekDniaWarszawa and dzienWarszawa == dayofweek.sunday, title = "Niedziela", style = shape.labelup, location = location.bottom, color = tloNazwyDnia, text = "Niedziela", textcolor = tekstNazwyDnia, size = size.tiny, display = display.pane, force_overlay = true)

// ==================== TYLKO OSTATNI POTWIERDZONY SFP ====================
var line ostatniaLinia = na
var int ostatniSygnalBar = na
var string ostatniSygnal = "Brak"
var float ostatniPoziom = na

if bearishSfp or bullishSfp
    if not na(ostatniaLinia)
        line.delete(ostatniaLinia)
    bool shortSignal = bearishSfp
    float poziom = shortSignal ? bearishPoziom : bullishPoziom
    int pivotBar = shortSignal ? bearishPivotBar : bullishPivotBar
    color sygnalKolor = shortSignal ? kolorShort : kolorLong
    if pokazOstatniSygnal
        ostatniaLinia := line.new(pivotBar, poziom, bar_index, poziom, xloc = xloc.bar_index, extend = extend.none, color = sygnalKolor, style = line.style_solid, width = 2, force_overlay = true)
    ostatniSygnalBar := bar_index
    ostatniSygnal := shortSignal ? "Bearish / SHORT" : "Bullish / LONG"
    ostatniPoziom := poziom

if not na(ostatniSygnalBar) and bar_index - ostatniSygnalBar > waznoscSygnalu
    if not na(ostatniaLinia)
        line.delete(ostatniaLinia)
        ostatniaLinia := na

// ==================== OPCJONALNY PANEL ====================
f_cena(float wartosc) => na(wartosc) ? "—" : str.tostring(wartosc, format.mintick)
float pierwszyHigh = array.size(wybraneHigh) > 0 ? array.get(wybraneHigh, 0) : na
float pierwszyLow = array.size(wybraneLow) > 0 ? array.get(wybraneLow, 0) : na
var table panel = table.new(position.top_right, 2, 4, bgcolor = color.new(color.black, 20), frame_color = color.new(color.gray, 65), frame_width = 1, force_overlay = true)
if barstate.islast
    if pokazPanel
        table.cell(panel, 0, 0, "SK SFP + FVG v5.3", text_color = color.white)
        table.cell(panel, 1, 0, timeframe.period + " / " + tryb, text_color = color.white)
        table.cell(panel, 0, 1, "Najbliższy high", text_color = kolorHigh)
        table.cell(panel, 1, 1, f_cena(pierwszyHigh), text_color = color.white)
        table.cell(panel, 0, 2, "Najbliższy low", text_color = kolorLow)
        table.cell(panel, 1, 2, f_cena(pierwszyLow), text_color = color.white)
        table.cell(panel, 0, 3, "Ostatni sygnał", text_color = color.silver)
        table.cell(panel, 1, 3, ostatniSygnal + " " + f_cena(ostatniPoziom), text_color = color.white)
    else
        table.clear(panel, 0, 0, 1, 3)

// ==================== ALERTY ====================
bool dowolneNoweFvg = noweBullFvg or noweBearFvg
bool dowolneNoweIfvg = noweBullIfvg or noweBearIfvg

alertcondition(alertujDotknieciaSfp and dotkniecieShortAlert, title = "SFP — dotknięcie HIGH / obserwacja SHORT", message = "Dotknięcie SFP HIGH na {{exchange}}:{{ticker}} | TF {{interval}} | cena {{close}}")
alertcondition(alertujDotknieciaSfp and dotkniecieLongAlert, title = "SFP — dotknięcie LOW / obserwacja LONG", message = "Dotknięcie SFP LOW na {{exchange}}:{{ticker}} | TF {{interval}} | cena {{close}}")
alertcondition(alertujDotknieciaSfp and (dotkniecieShortAlert or dotkniecieLongAlert), title = "SFP — dowolne dotknięcie poziomu", message = "Dotknięcie poziomu SFP na {{exchange}}:{{ticker}} | TF {{interval}} | cena {{close}}")
alertcondition(alertujPotwierdzeniaSfp and bearishSfp, title = "SFP — potwierdzony spadkowy / SHORT", message = "Potwierdzony spadkowy SFP na {{exchange}}:{{ticker}} | TF {{interval}} | zamknięcie {{close}}")
alertcondition(alertujPotwierdzeniaSfp and bullishSfp, title = "SFP — potwierdzony wzrostowy / LONG", message = "Potwierdzony wzrostowy SFP na {{exchange}}:{{ticker}} | TF {{interval}} | zamknięcie {{close}}")
alertcondition(alertujPotwierdzeniaSfp and (bearishSfp or bullishSfp), title = "SFP — dowolny potwierdzony sygnał", message = "Potwierdzony SFP na {{exchange}}:{{ticker}} | TF {{interval}} | zamknięcie {{close}}")
alertcondition(alertujNoweFvg and dowolneNoweFvg, title = "FVG 1H — nowa strefa", message = "Nowa strefa FVG 1H na {{exchange}}:{{ticker}} | cena {{close}}")
alertcondition(alertujNoweIfvg and dowolneNoweIfvg, title = "IFVG 1H — nowa inwersja", message = "Nowa strefa IFVG 1H na {{exchange}}:{{ticker}} | cena {{close}}")

if alertujDotknieciaSfp and (dotkniecieShortAlert or dotkniecieLongAlert)
    bool shortRadar = dotkniecieShortAlert
    float poziomAlertu = shortRadar ? dotkniecieHighPoziom : dotkniecieLowPoziom
    string stronaAlertu = shortRadar ? "HIGH" : "LOW"
    string kierunekAlertu = shortRadar ? "SHORT" : "LONG"
    string payload = "{\"event\":\"sfp_touch\",\"symbol\":\"" + syminfo.tickerid + "\",\"timeframe\":\"" + timeframe.period + "\",\"side\":\"" + stronaAlertu + "\",\"bias\":\"" + kierunekAlertu + "\",\"level\":\"" + str.tostring(poziomAlertu, format.mintick) + "\",\"price\":\"" + str.tostring(close, format.mintick) + "\",\"bar_time\":\"" + str.tostring(time) + "\"}"
    alert(payload, alert.freq_once_per_bar)

if alertujPotwierdzeniaSfp and bearishSfp
    alert("Potwierdzony spadkowy SFP / SHORT | " + syminfo.tickerid + " | TF " + timeframe.period + " | poziom " + str.tostring(bearishPoziom, format.mintick) + " | sweep " + str.tostring(bearishWybicie, format.mintick), alert.freq_once_per_bar_close)

if alertujPotwierdzeniaSfp and bullishSfp
    alert("Potwierdzony wzrostowy SFP / LONG | " + syminfo.tickerid + " | TF " + timeframe.period + " | poziom " + str.tostring(bullishPoziom, format.mintick) + " | sweep " + str.tostring(bullishWybicie, format.mintick), alert.freq_once_per_bar_close)

if alertujNoweFvg and dowolneNoweFvg
    string kierunekFvg = noweBullFvg ? "wzrostowe" : "spadkowe"
    alert("Nowe FVG 1H " + kierunekFvg + " | " + syminfo.tickerid + " | strefa " + str.tostring(noweFvgDol, format.mintick) + "–" + str.tostring(noweFvgGora, format.mintick), alert.freq_once_per_bar_close)

if alertujNoweIfvg and dowolneNoweIfvg
    string kierunekIfvg = noweBullIfvg ? "wzrostowe" : "spadkowe"
    alert("Nowe IFVG 1H " + kierunekIfvg + " | " + syminfo.tickerid + " | strefa " + str.tostring(noweIfvgDol, format.mintick) + "–" + str.tostring(noweIfvgGora, format.mintick), alert.freq_once_per_bar_close)
