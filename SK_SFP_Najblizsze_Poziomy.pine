[link1Time, link1R, link1S, link1TouchR, link1TouchS] = request.security(skanerLink, skanerTf1, f_skanuj_sfp(), lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
[link4Time, link4R, link4S, link4TouchR, link4TouchS] = request.security(skanerLink, skanerTf2, f_skanuj_sfp(), lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
[gold1Time, gold1R, gold1S, gold1TouchR, gold1TouchS] = request.security(skanerGold, skanerTf1, f_skanuj_sfp(), lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
