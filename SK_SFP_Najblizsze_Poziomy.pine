// ==================== TYLKO OSTATNI SFP RAW ====================
// RAW powstaje dopiero na zamknięciu świecy, gdy knot zamiata potwierdzony
// swing, a cały korpus wraca za poziom. To nadal setup oczekujący na CONF.
var line ostatniaRawLinia = na
var label ostatniaRawEtykieta = na
var int ostatniRawBar = na
var float ostatniRawPoziom = na
var int ostatniRawKierunek = 0  // -1 = SHORT, 1 = LONG

if bearishSetup or bullishSetup
    if not na(ostatniaRawLinia)
        line.delete(ostatniaRawLinia)
        ostatniaRawLinia := na
    if not na(ostatniaRawEtykieta)
        label.delete(ostatniaRawEtykieta)
        ostatniaRawEtykieta := na
    bool rawShort = bearishSetup
    float rawPoziom = rawShort ? bearishSetupPoziom : bullishSetupPoziom
    int rawPivotBar = rawShort ? bearishSetupPivotBar : bullishSetupPivotBar
    color rawKolor = rawShort ? kolorShort : kolorLong
    if pokazKierunkoweSfp and pokazSfpRaw
        ostatniaRawLinia := line.new(rawPivotBar, rawPoziom, bar_index, rawPoziom, xloc = xloc.bar_index, extend = extend.right, color = color.new(rawKolor, 28), style = line.style_dashed, width = 1, force_overlay = true)
        ostatniaRawEtykieta := label.new(bar_index + 1, rawPoziom, rawShort ? "SFP RAW SHORT" : "SFP RAW LONG", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.new(rawKolor, 8), size = size.tiny, force_overlay = true)
    ostatniRawBar := bar_index
    ostatniRawPoziom := rawPoziom
    ostatniRawKierunek := rawShort ? -1 : 1

if not na(ostatniRawBar) and bar_index - ostatniRawBar > waznoscRaw
    if not na(ostatniaRawLinia)
        line.delete(ostatniaRawLinia)
        ostatniaRawLinia := na
    if not na(ostatniaRawEtykieta)
        label.delete(ostatniaRawEtykieta)
        ostatniaRawEtykieta := na
    ostatniRawBar := na
    ostatniRawPoziom := na
    ostatniRawKierunek := 0

// ==================== TYLKO OSTATNI POTWIERDZONY SFP CONF ====================
var label ostatniaEtykieta = na
var int ostatniSygnalBar = na
var string ostatniSygnal = "Brak"
var float ostatniPoziom = na

if bearishSfp or bullishSfp
    if not na(ostatniaEtykieta)
        label.delete(ostatniaEtykieta)
    bool shortSignal = bearishSfp
    float poziom = shortSignal ? bearishPoziom : bullishPoziom
    int pivotBar = shortSignal ? bearishPivotBar : bullishPivotBar
    color sygnalKolor = shortSignal ? kolorShort : kolorLong
    int kierunekSygnalu = shortSignal ? -1 : 1
    // Ostatni RAW w tym samym kierunku jest poprzednikiem bieżącego CONF.
    // Nie wymagamy identycznej ceny co do ticka, bo poziom oczekującego setupu
    // może zostać znormalizowany inaczej między świecą RAW i potwierdzeniem.
    bool tenSamRaw = ostatniRawKierunek == kierunekSygnalu
    if tenSamRaw
        if not na(ostatniaRawLinia)
            line.delete(ostatniaRawLinia)
            ostatniaRawLinia := na
        if not na(ostatniaRawEtykieta)
            label.delete(ostatniaRawEtykieta)
            ostatniaRawEtykieta := na
        ostatniRawBar := na
        ostatniRawPoziom := na
        ostatniRawKierunek := 0
    if pokazOstatniSygnal
        // CONF to zdarzenie historyczne, nie poziom wejscia przy pozniejszym retescie.
        // Zostawiamy tylko krotka etykiete na swiecy potwierdzenia, bez poziomej linii.
        ostatniaEtykieta := label.new(bar_index, poziom, shortSignal ? "SFP CONF SHORT" : "SFP CONF LONG", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = sygnalKolor, size = size.tiny, force_overlay = true)
    ostatniSygnalBar := bar_index
    ostatniSygnal := shortSignal ? "Bearish / SHORT" : "Bullish / LONG"
    ostatniPoziom := poziom

if not na(ostatniSygnalBar) and bar_index - ostatniSygnalBar > waznoscSygnalu
    if not na(ostatniaEtykieta)
        label.delete(ostatniaEtykieta)
        ostatniaEtykieta := na

// ==================== WBUDOWANY SKANER SFP — 8 RYNKÓW, 1H + 4H ====================
// Stała lista nie zajmuje miejsca w legendzie. Skaner używa wyłącznie danych
// rynkowych i alertów; nie składa zleceń ani nie modyfikuje pozostałych alertów.
string skanerTf1 = "60"
string skanerTf2 = "240"
int skanerPivotLewy = 5
int skanerPivotPrawy = 5
int skanerPamiec = 6
float skanerTolerancja = 0.05 / 100.0

f_skan_najblizszy_opor(float reference, float p0, float p1, float p2, float p3, float p4, float p5) =>
    float nearest = na
    float[] candidates = array.from(p0, p1, p2, p3, p4, p5)
    for i = 0 to skanerPamiec - 1
        float candidate = array.get(candidates, i)
        if not na(candidate) and candidate > reference and (na(nearest) or candidate < nearest)
            nearest := candidate
    nearest

f_skan_najblizsze_wsparcie(float reference, float p0, float p1, float p2, float p3, float p4, float p5) =>
    float nearest = na
    float[] candidates = array.from(p0, p1, p2, p3, p4, p5)
    for i = 0 to skanerPamiec - 1
        float candidate = array.get(candidates, i)
        if not na(candidate) and candidate < reference and (na(nearest) or candidate > nearest)
            nearest := candidate
    nearest

f_skanuj_sfp() =>
    float ph = ta.pivothigh(high, skanerPivotLewy, skanerPivotPrawy)
    float pl = ta.pivotlow(low, skanerPivotLewy, skanerPivotPrawy)
    float h0 = ta.valuewhen(not na(ph), ph, 0)[1]
    float h1 = ta.valuewhen(not na(ph), ph, 1)[1]
    float h2 = ta.valuewhen(not na(ph), ph, 2)[1]
    float h3 = ta.valuewhen(not na(ph), ph, 3)[1]
    float h4 = ta.valuewhen(not na(ph), ph, 4)[1]
    float h5 = ta.valuewhen(not na(ph), ph, 5)[1]
    float l0 = ta.valuewhen(not na(pl), pl, 0)[1]
    float l1 = ta.valuewhen(not na(pl), pl, 1)[1]
    float l2 = ta.valuewhen(not na(pl), pl, 2)[1]
    float l3 = ta.valuewhen(not na(pl), pl, 3)[1]
    float l4 = ta.valuewhen(not na(pl), pl, 4)[1]
    float l5 = ta.valuewhen(not na(pl), pl, 5)[1]
    float reference = close[1]
    float resistance = f_skan_najblizszy_opor(reference, h0, h1, h2, h3, h4, h5)
    float support = f_skan_najblizsze_wsparcie(reference, l0, l1, l2, l3, l4, l5)
    bool touchingResistance = not na(resistance) and high >= resistance * (1.0 - skanerTolerancja) and low <= resistance * (1.0 + skanerTolerancja)
    bool touchingSupport = not na(support) and high >= support * (1.0 - skanerTolerancja) and low <= support * (1.0 + skanerTolerancja)
    [time, resistance, support, touchingResistance and not touchingResistance[1], touchingSupport and not touchingSupport[1]]

string skanerBtc = "OKX:BTCUSDT.P"
string skanerEth = "OKX:ETHUSDT.P"
string skanerSol = "OKX:SOLUSDT.P"
string skanerHype = "Hyperliquid:HYPEUSDC.P"
string skanerXrp = "OKX:XRPUSDT.P"
string skanerLink = "OKX:LINKUSDT.P"
string skanerGold = "COMEX:GC1!"
string skanerSilver = "COMEX:SI1!"

[btc1Time, btc1R, btc1S, btc1TouchR, btc1TouchS] = request.security(skanerBtc, skanerTf1, f_skanuj_sfp(), lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
[btc4Time, btc4R, btc4S, btc4TouchR, btc4TouchS] = request.security(skanerBtc, skanerTf2, f_skanuj_sfp(), lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
