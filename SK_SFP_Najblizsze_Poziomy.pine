const string WM_MAP_DOUBLE = "𝔸 𝔹 ℂ 𝔻 𝔼 𝔽 𝔾 ℍ 𝕀 𝕁 𝕂 𝕃 𝕄 ℕ 𝕆 ℙ ℚ ℝ 𝕊 𝕋 𝕌 𝕍 𝕎 𝕏 𝕐 ℤ 𝕒 𝕓 𝕔 𝕕 𝕖 𝕗 𝕘 𝕙 𝕚 𝕛 𝕜 𝕝 𝕞 𝕟 𝕠 𝕡 𝕢 𝕣 𝕤 𝕥 𝕦 𝕧 𝕨 𝕩 𝕪 𝕫 𝟘 𝟙 𝟚 𝟛 𝟜 𝟝 𝟞 𝟟 𝟠 𝟡"
const string WM_EXTRA = "ąćęłńóśźżĄĆĘŁŃÓŚŹŻáàâäãåéèêëíìîïòôöõúùûüñçÁÀÂÄÃÅÉÈÊËÍÌÎÏÒÔÖÕÚÙÛÜÑÇ!#$%&()*+,-./:;<=>?@[]^_{|}~"
const string WM_UNDERLINE = "̲"
const string WM_STRIKE = "̶"

f_wm_mapa(string font) =>
    switch font
        WM_FONT_SERIF => WM_MAP_SERIF
        WM_FONT_SERIF_ITALIC => WM_MAP_SERIF_ITALIC
        WM_FONT_SANS => WM_MAP_SANS
        WM_FONT_SANS_ITALIC => WM_MAP_SANS_ITALIC
        WM_FONT_SCRIPT => WM_MAP_SCRIPT
        WM_FONT_FRAKTUR => WM_MAP_FRAKTUR
        WM_FONT_DOUBLE => WM_MAP_DOUBLE
        => ""

f_wm_stylizuj(string source, string font, string lineStyle) =>
    string mark = lineStyle == WM_LINE_UNDERLINE ? WM_UNDERLINE : lineStyle == WM_LINE_STRIKE ? WM_STRIKE : ""
    string mapText = f_wm_mapa(font)
    bool restyle = mapText != ""
    string[] charMap = restyle ? str.split(mapText, " ") : array.new_string()
    string result = source
    if restyle or mark != ""
        for i = 0 to str.length(WM_PLAIN) - 1
            string plain = str.substring(WM_PLAIN, i, i + 1)
            result := str.replace_all(result, plain, (restyle ? array.get(charMap, i) : plain) + mark)
    if mark != ""
        for i = 0 to str.length(WM_EXTRA) - 1
            string extra = str.substring(WM_EXTRA, i, i + 1)
            result := str.replace_all(result, extra, extra + mark)
        result := str.replace_all(result, " ", " " + mark)
    result

f_wm_font(string font) =>
    font == WM_FONT_MONO ? font.family_monospace : font.family_default

f_wm_format(bool bold, bool italic) =>
    (bold ? text.format_bold : text.format_none) + (italic ? text.format_italic : text.format_none)

f_wm_position(string choice) =>
    switch choice
        WM_POS_TOP_LEFT => position.top_left
        WM_POS_TOP_RIGHT => position.top_right
        WM_POS_MIDDLE => position.middle_center
        WM_POS_BOTTOM_CENTER => position.bottom_center
        WM_POS_BOTTOM_LEFT => position.bottom_left
        WM_POS_BOTTOM_RIGHT => position.bottom_right
        => position.top_center

f_wm_align(string choice) =>
    choice == WM_POS_TOP_LEFT or choice == WM_POS_BOTTOM_LEFT ? text.align_left : choice == WM_POS_TOP_RIGHT or choice == WM_POS_BOTTOM_RIGHT ? text.align_right : text.align_center

bool wmNaDole = wmPozycja == WM_POS_BOTTOM_CENTER or wmPozycja == WM_POS_BOTTOM_LEFT or wmPozycja == WM_POS_BOTTOM_RIGHT
bool wmUzyjOdsuniecia = wmOdsuniecie > 0 and wmPozycja != WM_POS_MIDDLE
bool wmMaGlowny = wmPokaz and str.length(str.trim(wmTekstGlowny)) > 0
bool wmMaDrugi = wmPokaz and str.length(str.trim(wmTekstDrugi)) > 0
var table wmTabela = table.new(f_wm_position(wmPozycja), 1, 3, frame_width = 0, border_width = 0)
var string wmGlownyPoStylu = f_wm_stylizuj(wmTekstGlowny, wmFontGlowny, wmLiniaGlowna)
var string wmDrugiPoStylu = f_wm_stylizuj(wmTekstDrugi, wmFontDrugi, wmLiniaDruga)

if barstate.islast
    table.clear(wmTabela, 0, 0, 0, 2)
    if wmPokaz
        string align = f_wm_align(wmPozycja)
        int row = 0
        if wmUzyjOdsuniecia and not wmNaDole
            table.cell(wmTabela, 0, row, "", height = wmOdsuniecie)
            row += 1
        if wmMaGlowny
            table.cell(wmTabela, 0, row, wmGlownyPoStylu, text_color = wmKolorGlowny, text_size = wmRozmiarGlowny, text_halign = align, text_font_family = f_wm_font(wmFontGlowny), text_formatting = f_wm_format(wmBoldGlowny, wmItalicGlowny))
            row += 1
        if wmMaDrugi
            table.cell(wmTabela, 0, row, wmDrugiPoStylu, text_color = wmKolorDrugi, text_size = wmRozmiarDrugi, text_halign = align, text_font_family = f_wm_font(wmFontDrugi), text_formatting = f_wm_format(wmBoldDrugi, wmItalicDrugi))
            row += 1
        if wmUzyjOdsuniecia and wmNaDole
            table.cell(wmTabela, 0, row, "", height = wmOdsuniecie)
