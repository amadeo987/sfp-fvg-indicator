color kolorSeparatorow = color.white

// ==================== ŚREDNIE KROCZĄCE ====================
// Wszystkie EMA liczą się bezpośrednio z zamknięć na aktualnym interwale wykresu.
float ema200 = ta.ema(close, 200)
float ema100 = ta.ema(close, 100)
float ema50 = ta.ema(close, 50)
float emaWlasna = ta.ema(close, dlugoscEmaWlasna)

plot(pokazEma200 ? ema200 : na, title = "EMA 200", color = kolorEma200, linewidth = gruboscEma)
plot(pokazEma100 ? ema100 : na, title = "EMA 100", color = kolorEma100, linewidth = gruboscEma)
plot(pokazEma50 ? ema50 : na, title = "EMA 50", color = kolorEma50, linewidth = gruboscEma)
plot(pokazEmaWlasna ? emaWlasna : na, title = "Custom EMA", color = kolorEmaWlasna, linewidth = gruboscEma)

// ==================== DUAL AUTO VWAP ====================
// Szybka i wolna kotwica zmieniają okres automatycznie wraz z interwałem wykresu.
// Na intraday odpowiadają odpowiednio bieżącej sesji/dniu i bieżącemu tygodniowi.
// Obie linie korzystają z typowej ceny hlc3 i nie emitują żadnych alertów.
float sekundyWykresu = timeframe.in_seconds()
float sekundyJednegoDnia = timeframe.in_seconds("1D")
float sekundyDziesieciuDni = timeframe.in_seconds("10D")
float sekundySzesdziesieciuDni = timeframe.in_seconds("60D")
bool interwalIntraday = timeframe.isintraday
bool interwalJednodniowy = not interwalIntraday and sekundyWykresu <= sekundyJednegoDnia
bool interwalDoDziesieciuDni = not interwalIntraday and not interwalJednodniowy and sekundyWykresu <= sekundyDziesieciuDni
bool interwalDoSzesdziesieciuDni = not interwalIntraday and not interwalJednodniowy and not interwalDoDziesieciuDni and sekundyWykresu <= sekundySzesdziesieciuDni
bool nowaDekada = barstate.isfirst or (year != year[1] and year % 10 == 0)
bool noweStulecie = barstate.isfirst or (year != year[1] and year % 100 == 0)

bool resetVwapSzybki = barstate.isfirst or (interwalIntraday ? timeframe.change("1D") : interwalJednodniowy ? timeframe.change("1M") : interwalDoDziesieciuDni ? timeframe.change("3M") : interwalDoSzesdziesieciuDni ? timeframe.change("12M") : nowaDekada)
bool resetVwapWolny = barstate.isfirst or (interwalIntraday ? timeframe.change("1W") : interwalJednodniowy ? timeframe.change("3M") : interwalDoDziesieciuDni ? timeframe.change("12M") : interwalDoSzesdziesieciuDni ? nowaDekada : noweStulecie)

float vwapSzybki = ta.vwap(hlc3, resetVwapSzybki)
float vwapWolny = ta.vwap(hlc3, resetVwapWolny)

// Nie ukrywamy świecy resetu. ta.vwap() zwraca już na niej pierwszy punkt nowej
// kotwicy, więc linia nie dostaje sztucznej jednoswiecowej dziury.
plot(pokazVwapSzybki ? vwapSzybki : na, title = "Fast Auto VWAP", color = kolorVwapSzybki, linewidth = gruboscVwap, style = plot.style_linebr)
plot(pokazVwapWolny ? vwapWolny : na, title = "Slow Auto VWAP", color = kolorVwapWolny, linewidth = gruboscVwap, style = plot.style_linebr)

// ==================== PAMIĘĆ JAKOŚCIOWYCH SWINGÓW ====================
var float[] cenyHigh = array.new_float()
var int[] baryHigh = array.new_int()
var float[] jakoscHigh = array.new_float()
var float[] cenyLow = array.new_float()
var int[] baryLow = array.new_int()
var float[] jakoscLow = array.new_float()
var float[] dotknieteHigh = array.new_float()
var int[] dotknieteHighPivotBar = array.new_int()
var int[] dotknieteHighBar = array.new_int()
var float[] dotknieteLow = array.new_float()
var int[] dotknieteLowPivotBar = array.new_int()
var int[] dotknieteLowBar = array.new_int()
// Ostatnia zuzyta pula po każdej stronie. Stary poziom nie może wrócić do
// radaru po CONF; poziom o zbliżonej cenie staje się ponownie ważny dopiero,
// gdy po potwierdzeniu powstanie nowy pivot.
var float ostatniZuzytyHigh = na
var int ostatniZuzytyHighBar = na
var float ostatniZuzytyLow = na
var int ostatniZuzytyLowBar = na

f_dodaj_lub_polacz(float[] ceny, int[] bary, float[] jakosci, float nowaCena, int nowyBar, float nowaJakosc, float progLaczenia) =>
    int indeks = -1
    if array.size(ceny) > 0
        for i = 0 to array.size(ceny) - 1
            if math.abs(nowaCena - array.get(ceny, i)) <= progLaczenia
                indeks := i
                break
    if indeks >= 0
        float staraJakosc = array.get(jakosci, indeks)
        int staryBar = array.get(bary, indeks)
        if nowaJakosc > staraJakosc or (nowaJakosc == staraJakosc and nowyBar > staryBar)
            array.set(ceny, indeks, nowaCena)
            array.set(bary, indeks, nowyBar)
            array.set(jakosci, indeks, nowaJakosc)
    else
        array.push(ceny, nowaCena)
        array.push(bary, nowyBar)
        array.push(jakosci, nowaJakosc)
    while array.size(ceny) > 100
        array.shift(ceny)
        array.shift(bary)
        array.shift(jakosci)

f_zapamietaj_dotkniety(float[] ceny, int[] baryPivot, int[] baryDotkniecia, float cena, int pivotBar) =>
    array.push(ceny, cena)
    array.push(baryPivot, pivotBar)
    array.push(baryDotkniecia, bar_index)
    while array.size(ceny) > 20
        array.shift(ceny)
        array.shift(baryPivot)
        array.shift(baryDotkniecia)

f_usun_dotkniety(float[] ceny, int[] baryPivot, int[] baryDotkniecia, float cena) =>
    if array.size(ceny) > 0
        for i = array.size(ceny) - 1 to 0
            if math.abs(array.get(ceny, i) - cena) <= syminfo.mintick
                array.remove(ceny, i)
                array.remove(baryPivot, i)
                array.remove(baryDotkniecia, i)

f_usun_aktywna_pule(float[] ceny, int[] bary, float[] jakosci, float cena, int pivotBar) =>
    if array.size(ceny) > 0
        for i = array.size(ceny) - 1 to 0
            bool tenSamPivot = array.get(bary, i) == pivotBar
            bool tenSamPoziom = math.abs(array.get(ceny, i) - cena) <= syminfo.mintick
            if tenSamPivot or tenSamPoziom
                array.remove(ceny, i)
                array.remove(bary, i)
                array.remove(jakosci, i)

float atr = ta.atr(okresAtr)
float pivotHigh = ta.pivothigh(high, swieceSwingu, swieceSwingu)
float pivotLow = ta.pivotlow(low, swieceSwingu, swieceSwingu)
float atrSwingu = nz(atr[swieceSwingu], atr)
float progLaczenia = math.max(syminfo.mintick, atrSwingu * laczenieAtr)
float najnizszyPoHigh = ta.lowest(low, swieceSwingu + 1)
float najwyzszyPoLow = ta.highest(high, swieceSwingu + 1)

if not na(pivotHigh) and atrSwingu > 0
    float reakcja = (pivotHigh - najnizszyPoHigh) / atrSwingu
    if reakcja >= minReakcjaAtr
        f_dodaj_lub_polacz(cenyHigh, baryHigh, jakoscHigh, pivotHigh, bar_index - swieceSwingu, reakcja, progLaczenia)

if not na(pivotLow) and atrSwingu > 0
    float reakcja = (najwyzszyPoLow - pivotLow) / atrSwingu
    if reakcja >= minReakcjaAtr
        f_dodaj_lub_polacz(cenyLow, baryLow, jakoscLow, pivotLow, bar_index - swieceSwingu, reakcja, progLaczenia)

// Pierwsze dotknięcie jest wykrywane na otwartej świecy, zanim potwierdzona świeca
// przeniesie zużyty poziom z aktywnego radaru do pamięci poziomów dotkniętych.
// Dzięki temu alert nie czeka na zamknięcie świecy.
float cenaOdniesieniaRadaru = barstate.isconfirmed ? close : nz(close[1], close)
float limitOdleglosciRadaru = atr * maksOdlegloscAtr
bool dotkniecieHighTeraz = false
float dotkniecieHighPoziom = na
float dotkniecieHighOdleglosc = 1e20
bool dotkniecieLowTeraz = false
float dotkniecieLowPoziom = na
float dotkniecieLowOdleglosc = 1e20

if array.size(cenyHigh) > 0
    for i = 0 to array.size(cenyHigh) - 1
        float poziom = array.get(cenyHigh, i)
        int pivotBar = array.get(baryHigh, i)
        float odleglosc = math.abs(cenaOdniesieniaRadaru - poziom)
        bool aktywny = bar_index > pivotBar and bar_index - pivotBar <= maksWiek and odleglosc <= limitOdleglosciRadaru
        if aktywny and high >= poziom and odleglosc < dotkniecieHighOdleglosc
            dotkniecieHighTeraz := true
            dotkniecieHighPoziom := poziom
            dotkniecieHighOdleglosc := odleglosc

if array.size(cenyLow) > 0
    for i = 0 to array.size(cenyLow) - 1
        float poziom = array.get(cenyLow, i)
        int pivotBar = array.get(baryLow, i)
        float odleglosc = math.abs(cenaOdniesieniaRadaru - poziom)
        bool aktywny = bar_index > pivotBar and bar_index - pivotBar <= maksWiek and odleglosc <= limitOdleglosciRadaru
        if aktywny and low <= poziom and odleglosc < dotkniecieLowOdleglosc
            dotkniecieLowTeraz := true
            dotkniecieLowPoziom := poziom
            dotkniecieLowOdleglosc := odleglosc

bool dotkniecieShortAlert = dotkniecieHighTeraz and (not dotkniecieLowTeraz or dotkniecieHighOdleglosc <= dotkniecieLowOdleglosc)
bool dotkniecieLongAlert = dotkniecieLowTeraz and not dotkniecieShortAlert

// ==================== SWEEP = SETUP, BREAK STRUKTURY = CONF ====================
float sredniWolumen = ta.sma(volume, okresWolumenu)
bool wolumenOk = not filtrWolumenu or (not na(volume) and not na(sredniWolumen) and volume >= sredniWolumen * mnoznikWolumenu)
float minSweep = atr * minSweepAtr
float maxSweep = maxSweepAtr == 0.0 ? 1e20 : atr * maxSweepAtr

bool bearishSetup = false
float bearishSetupPoziom = na
int bearishSetupPivotBar = na
float bearishSetupWybicie = na
bool bullishSetup = false
float bullishSetupPoziom = na
int bullishSetupPivotBar = na
float bullishSetupWybicie = na

if barstate.isconfirmed and array.size(cenyHigh) > 0
    for i = array.size(cenyHigh) - 1 to 0
        float poziom = array.get(cenyHigh, i)
        int pivotBar = array.get(baryHigh, i)
        bool wygasl = bar_index - pivotBar > maksWiek
        bool naruszony = high >= poziom
        if wygasl or naruszony
            if naruszony
                if pokazDotkniete
                    f_zapamietaj_dotkniety(dotknieteHigh, dotknieteHighPivotBar, dotknieteHighBar, poziom, pivotBar)
                float wybicie = high - poziom
                bool zakresOk = minZakresSetupAtr == 0.0 or high - low >= atr * minZakresSetupAtr
                bool setup = close < poziom and (not calyKorpus or open < poziom) and wybicie >= minSweep and wybicie <= maxSweep and wolumenOk and zakresOk
                if setup and (not bearishSetup or poziom < bearishSetupPoziom)
                    bearishSetup := true
                    bearishSetupPoziom := poziom
                    bearishSetupPivotBar := pivotBar
                    bearishSetupWybicie := wybicie
            array.remove(cenyHigh, i)
            array.remove(baryHigh, i)
            array.remove(jakoscHigh, i)

if barstate.isconfirmed and array.size(cenyLow) > 0
    for i = array.size(cenyLow) - 1 to 0
        float poziom = array.get(cenyLow, i)
        int pivotBar = array.get(baryLow, i)
        bool wygasl = bar_index - pivotBar > maksWiek
        bool naruszony = low <= poziom
        if wygasl or naruszony
            if naruszony
                if pokazDotkniete
                    f_zapamietaj_dotkniety(dotknieteLow, dotknieteLowPivotBar, dotknieteLowBar, poziom, pivotBar)
                float wybicie = poziom - low
                bool zakresOk = minZakresSetupAtr == 0.0 or high - low >= atr * minZakresSetupAtr
                bool setup = close > poziom and (not calyKorpus or open > poziom) and wybicie >= minSweep and wybicie <= maxSweep and wolumenOk and zakresOk
                if setup and (not bullishSetup or poziom > bullishSetupPoziom)
                    bullishSetup := true
                    bullishSetupPoziom := poziom
                    bullishSetupPivotBar := pivotBar
                    bullishSetupWybicie := wybicie
            array.remove(cenyLow, i)
            array.remove(baryLow, i)
            array.remove(jakoscLow, i)

// Po pierwszym naruszeniu poziom trafia do krótkiej pamięci. Drugi osobny retest
// (cena musi najpierw wrócić na właściwą stronę) usuwa go natychmiast, żeby stara
// pula płynności nie wisiała na wykresie po wielokrotnym przykryciu.
float limitDotknietych = atr * usunDotknietyPoAtr
if barstate.isconfirmed and array.size(dotknieteHigh) > 0
    for i = array.size(dotknieteHigh) - 1 to 0
        float poziom = array.get(dotknieteHigh, i)
        bool zaStary = bar_index - array.get(dotknieteHighBar, i) > pamiecDotknietych
        bool zaDaleko = math.abs(close - poziom) > limitDotknietych
        bool drugiRetest = bar_index > array.get(dotknieteHighBar, i) and high >= poziom and high[1] < poziom
        if not pokazDotkniete or zaStary or zaDaleko or drugiRetest
            array.remove(dotknieteHigh, i)
            array.remove(dotknieteHighPivotBar, i)
            array.remove(dotknieteHighBar, i)

if barstate.isconfirmed and array.size(dotknieteLow) > 0
    for i = array.size(dotknieteLow) - 1 to 0
        float poziom = array.get(dotknieteLow, i)
        bool zaStary = bar_index - array.get(dotknieteLowBar, i) > pamiecDotknietych
        bool zaDaleko = math.abs(close - poziom) > limitDotknietych
        bool drugiRetest = bar_index > array.get(dotknieteLowBar, i) and low <= poziom and low[1] > poziom
        if not pokazDotkniete or zaStary or zaDaleko or drugiRetest
            array.remove(dotknieteLow, i)
            array.remove(dotknieteLowPivotBar, i)
            array.remove(dotknieteLowBar, i)

var bool oczekujeBear = false
var float oczekujeBearPoziom = na
var int oczekujeBearPivotBar = na
var float oczekujeBearHigh = na
var float oczekujeBearLow = na
var float oczekujeBearAtr = na
var float oczekujeBearWybicie = na
var int oczekujeBearBar = na
var bool oczekujeBull = false
var float oczekujeBullPoziom = na
var int oczekujeBullPivotBar = na
var float oczekujeBullHigh = na
var float oczekujeBullLow = na
var float oczekujeBullAtr = na
var float oczekujeBullWybicie = na
var int oczekujeBullBar = na

bool bearishSfp = false
float bearishPoziom = na
int bearishPivotBar = na
float bearishWybicie = na
bool bullishSfp = false
float bullishPoziom = na
int bullishPivotBar = na
float bullishWybicie = na

if barstate.isconfirmed and sposobPotwierdzenia == "Break struktury"
    if oczekujeBear and bar_index > oczekujeBearBar
        bool uniewazniony = high > oczekujeBearHigh + oczekujeBearAtr * buforUniewaznieniaAtr
        bool wygasl = bar_index - oczekujeBearBar > oknoPotwierdzenia
        bool potwierdzony = close < oczekujeBearLow
        if uniewazniony or wygasl
            oczekujeBear := false
        else if potwierdzony
            bearishSfp := true
            bearishPoziom := oczekujeBearPoziom
            bearishPivotBar := oczekujeBearPivotBar
            bearishWybicie := oczekujeBearWybicie
            oczekujeBear := false
    if oczekujeBull and bar_index > oczekujeBullBar
        bool uniewazniony = low < oczekujeBullLow - oczekujeBullAtr * buforUniewaznieniaAtr
        bool wygasl = bar_index - oczekujeBullBar > oknoPotwierdzenia
        bool potwierdzony = close > oczekujeBullHigh
        if uniewazniony or wygasl
            oczekujeBull := false
        else if potwierdzony
            bullishSfp := true
            bullishPoziom := oczekujeBullPoziom
            bullishPivotBar := oczekujeBullPivotBar
            bullishWybicie := oczekujeBullWybicie
            oczekujeBull := false

if bearishSetup
    if sposobPotwierdzenia == "Sam powrót świecy"
        bearishSfp := true
        bearishPoziom := bearishSetupPoziom
        bearishPivotBar := bearishSetupPivotBar
        bearishWybicie := bearishSetupWybicie
    else
        oczekujeBear := true
        oczekujeBearPoziom := bearishSetupPoziom
        oczekujeBearPivotBar := bearishSetupPivotBar
        oczekujeBearHigh := high
        oczekujeBearLow := low
        oczekujeBearAtr := atr
        oczekujeBearWybicie := bearishSetupWybicie
        oczekujeBearBar := bar_index

if bullishSetup
    if sposobPotwierdzenia == "Sam powrót świecy"
        bullishSfp := true
        bullishPoziom := bullishSetupPoziom
        bullishPivotBar := bullishSetupPivotBar
        bullishWybicie := bullishSetupWybicie
    else
        oczekujeBull := true
        oczekujeBullPoziom := bullishSetupPoziom
        oczekujeBullPivotBar := bullishSetupPivotBar
        oczekujeBullHigh := high
        oczekujeBullLow := low
        oczekujeBullAtr := atr
        oczekujeBullWybicie := bullishSetupWybicie
        oczekujeBullBar := bar_index

// Potwierdzony setup jest już rozegranym zdarzeniem. Usuwamy jego poziom z
// pamięci dotkniętych pul przed rysowaniem radaru, żeby nie wyglądał później
// jak aktualny poziom wejścia przy retescie.
if bearishSfp
    ostatniZuzytyHigh := bearishPoziom
    ostatniZuzytyHighBar := bar_index
    f_usun_aktywna_pule(cenyHigh, baryHigh, jakoscHigh, bearishPoziom, bearishPivotBar)
    f_usun_dotkniety(dotknieteHigh, dotknieteHighPivotBar, dotknieteHighBar, bearishPoziom)
if bullishSfp
    ostatniZuzytyLow := bullishPoziom
    ostatniZuzytyLowBar := bar_index
    f_usun_aktywna_pule(cenyLow, baryLow, jakoscLow, bullishPoziom, bullishPivotBar)
    f_usun_dotkniety(dotknieteLow, dotknieteLowPivotBar, dotknieteLowBar, bullishPoziom)

// ==================== WYBÓR TYLKO NAJBLIŻSZYCH POZIOMÓW ====================
var float[] wybraneHigh = array.new_float()
var int[] wybraneHighBar = array.new_int()
var float[] wybraneLow = array.new_float()
var int[] wybraneLowBar = array.new_int()
array.clear(wybraneHigh)
array.clear(wybraneHighBar)
array.clear(wybraneLow)
array.clear(wybraneLowBar)

float limitOdleglosci = limitOdleglosciRadaru

if ileNadCena > 0 and array.size(cenyHigh) > 0
    for i = 0 to array.size(cenyHigh) - 1
        float poziom = array.get(cenyHigh, i)
        int pivotBar = array.get(baryHigh, i)
        bool zuzytyPrzedConf = not na(ostatniZuzytyHigh) and pivotBar <= ostatniZuzytyHighBar and math.abs(poziom - ostatniZuzytyHigh) <= progLaczenia
        if not zuzytyPrzedConf and poziom > cenaOdniesieniaRadaru and poziom - cenaOdniesieniaRadaru <= limitOdleglosci
            int pozycja = array.size(wybraneHigh)
            if array.size(wybraneHigh) > 0
                for j = 0 to array.size(wybraneHigh) - 1
                    if poziom < array.get(wybraneHigh, j)
                        pozycja := j
                        break
            array.insert(wybraneHigh, pozycja, poziom)
            array.insert(wybraneHighBar, pozycja, array.get(baryHigh, i))
            while array.size(wybraneHigh) > ileNadCena
                array.pop(wybraneHigh)
                array.pop(wybraneHighBar)

if ilePodCena > 0 and array.size(cenyLow) > 0
    for i = 0 to array.size(cenyLow) - 1
        float poziom = array.get(cenyLow, i)
        int pivotBar = array.get(baryLow, i)
        bool zuzytyPrzedConf = not na(ostatniZuzytyLow) and pivotBar <= ostatniZuzytyLowBar and math.abs(poziom - ostatniZuzytyLow) <= progLaczenia
        if not zuzytyPrzedConf and poziom < cenaOdniesieniaRadaru and cenaOdniesieniaRadaru - poziom <= limitOdleglosci
            int pozycja = array.size(wybraneLow)
            if array.size(wybraneLow) > 0
                for j = 0 to array.size(wybraneLow) - 1
                    if poziom > array.get(wybraneLow, j)
                        pozycja := j
                        break
            array.insert(wybraneLow, pozycja, poziom)
            array.insert(wybraneLowBar, pozycja, array.get(baryLow, i))
            while array.size(wybraneLow) > ilePodCena
                array.pop(wybraneLow)
                array.pop(wybraneLowBar)

// ==================== CZYSTE RYSOWANIE RADARU ====================
var line[] linieRadaru = array.new_line()
var label[] etykietyRadaru = array.new_label()

if barstate.islast
    if array.size(linieRadaru) > 0
        for i = array.size(linieRadaru) - 1 to 0
            line.delete(array.get(linieRadaru, i))
    if array.size(etykietyRadaru) > 0
        for i = array.size(etykietyRadaru) - 1 to 0
            label.delete(array.get(etykietyRadaru, i))
    array.clear(linieRadaru)
    array.clear(etykietyRadaru)

    if array.size(wybraneHigh) > 0
        for i = 0 to array.size(wybraneHigh) - 1
            float poziom = array.get(wybraneHigh, i)
            int pivotBar = array.get(wybraneHighBar, i)
            int przezroczystosc = i == 0 ? 0 : 25
            bool dotknietyNaOtwartej = not barstate.isconfirmed and high >= poziom
            line ln = line.new(pivotBar, poziom, bar_index, poziom, xloc = xloc.bar_index, extend = extend.right, color = color.new(kolorHigh, dotknietyNaOtwartej ? 48 : przezroczystosc), style = dotknietyNaOtwartej ? line.style_dashed : line.style_solid, width = dotknietyNaOtwartej ? 1 : i == 0 ? 2 : 1, force_overlay = true)
            array.push(linieRadaru, ln)
            if pokazNazwy
                string tekst = dotknietyNaOtwartej ? "SFP" : "SFP?"
                label lb = label.new(bar_index + 1, poziom, tekst, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(kolorHigh, dotknietyNaOtwartej ? 62 : 15), textcolor = color.white, size = size.tiny, force_overlay = true)
                array.push(etykietyRadaru, lb)

    if array.size(wybraneLow) > 0
        for i = 0 to array.size(wybraneLow) - 1
            float poziom = array.get(wybraneLow, i)
            int pivotBar = array.get(wybraneLowBar, i)
            int przezroczystosc = i == 0 ? 0 : 25
            bool dotknietyNaOtwartej = not barstate.isconfirmed and low <= poziom
            line ln = line.new(pivotBar, poziom, bar_index, poziom, xloc = xloc.bar_index, extend = extend.right, color = color.new(kolorLow, dotknietyNaOtwartej ? 48 : przezroczystosc), style = dotknietyNaOtwartej ? line.style_dashed : line.style_solid, width = dotknietyNaOtwartej ? 1 : i == 0 ? 2 : 1, force_overlay = true)
            array.push(linieRadaru, ln)
            if pokazNazwy
                string tekst = dotknietyNaOtwartej ? "SFP" : "SFP?"
                label lb = label.new(bar_index + 1, poziom, tekst, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(kolorLow, dotknietyNaOtwartej ? 62 : 15), textcolor = color.white, size = size.tiny, force_overlay = true)
                array.push(etykietyRadaru, lb)

    if pokazDotkniete and ileDotknietychNaStrone > 0 and array.size(dotknieteHigh) > 0
        int narysowaneHigh = 0
        for i = array.size(dotknieteHigh) - 1 to 0
            if narysowaneHigh < ileDotknietychNaStrone
                float poziom = array.get(dotknieteHigh, i)
                int pivotBar = array.get(dotknieteHighPivotBar, i)
                bool zuzytyPrzedConf = not na(ostatniZuzytyHigh) and pivotBar <= ostatniZuzytyHighBar and math.abs(poziom - ostatniZuzytyHigh) <= progLaczenia
                if not zuzytyPrzedConf
                    line ln = line.new(pivotBar, poziom, bar_index, poziom, xloc = xloc.bar_index, extend = extend.right, color = color.new(kolorHigh, 58), style = line.style_dashed, width = 1, force_overlay = true)
                    array.push(linieRadaru, ln)
                    if pokazNazwy
                        label lb = label.new(bar_index + 1, poziom, "SFP", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(kolorHigh, 62), textcolor = color.white, size = size.tiny, force_overlay = true)
                        array.push(etykietyRadaru, lb)
                    narysowaneHigh += 1

    if pokazDotkniete and ileDotknietychNaStrone > 0 and array.size(dotknieteLow) > 0
        int narysowaneLow = 0
        for i = array.size(dotknieteLow) - 1 to 0
            if narysowaneLow < ileDotknietychNaStrone
                float poziom = array.get(dotknieteLow, i)
                int pivotBar = array.get(dotknieteLowPivotBar, i)
                bool zuzytyPrzedConf = not na(ostatniZuzytyLow) and pivotBar <= ostatniZuzytyLowBar and math.abs(poziom - ostatniZuzytyLow) <= progLaczenia
                if not zuzytyPrzedConf
                    line ln = line.new(pivotBar, poziom, bar_index, poziom, xloc = xloc.bar_index, extend = extend.right, color = color.new(kolorLow, 58), style = line.style_dashed, width = 1, force_overlay = true)
                    array.push(linieRadaru, ln)
                    if pokazNazwy
                        label lb = label.new(bar_index + 1, poziom, "SFP", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(kolorLow, 62), textcolor = color.white, size = size.tiny, force_overlay = true)
                        array.push(etykietyRadaru, lb)
                    narysowaneLow += 1

// ==================== FVG / IFVG — CONFIRMED MULTI-TIMEFRAME BOOKS ====================
// Every source uses the last closed source candle with lookahead_on. This is the
// non-repainting HTF request pattern: a zone can only change on a confirmed
// source-timeframe close, never while that source candle is still forming.
f_tf_label(string tf) =>
    tf == "1" ? "1m" : tf == "3" ? "3m" : tf == "5" ? "5m" : tf == "15" ? "15m" : tf == "30" ? "30m" : tf == "60" ? "1H" : tf == "120" ? "2H" : tf == "240" ? "4H" : tf == "1D" or tf == "D" ? "1D" : tf == "1W" or tf == "W" ? "1W" : tf

f_clear_book(float[] tops, float[] bottoms, int[] directions, bool[] inversions, int[] startTimes, int[] inversionTimes) =>
    array.clear(tops)
    array.clear(bottoms)
    array.clear(directions)
    array.clear(inversions)
    array.clear(startTimes)
    array.clear(inversionTimes)

f_update_book(float[] tops, float[] bottoms, int[] directions, bool[] inversions, int[] startTimes, int[] inversionTimes, bool enabled, int sourceTime, float sourceHigh, float sourceLow, float sourceClose, float firstHigh, float firstLow, float sourceAtr, int sourceMs) =>
    bool newBullFvg = false
    bool newBearFvg = false
    bool newBullIfvg = false
    bool newBearIfvg = false
    float newFvgTop = na
    float newFvgBottom = na
    float newIfvgTop = na
    float newIfvgBottom = na
    int sourceTimeChange = ta.change(sourceTime)
    bool newClosedSourceBar = enabled and not na(sourceTime) and sourceTimeChange != 0

    if not enabled
        f_clear_book(tops, bottoms, directions, inversions, startTimes, inversionTimes)

    if newClosedSourceBar
        if array.size(tops) > 0
            for i = array.size(tops) - 1 to 0
                float zoneTop = array.get(tops, i)
                float zoneBottom = array.get(bottoms, i)
                int direction = array.get(directions, i)
                bool inverted = array.get(inversions, i)
                int ageStart = inverted and not na(array.get(inversionTimes, i)) ? array.get(inversionTimes, i) : array.get(startTimes, i)
                int maxAge = inverted ? maksWiekStrefIfvg : maksWiekStrefFvg
                bool removeZone = sourceTime - ageStart > maxAge * sourceMs

                if not removeZone and not inverted
                    bool inversion = (direction == 1 and sourceClose < zoneBottom) or (direction == -1 and sourceClose > zoneTop)
                    bool filled = (direction == 1 and sourceLow <= zoneBottom) or (direction == -1 and sourceHigh >= zoneTop)
                    if inversion
                        int newDirection = -direction
                        bool invertedFilled = (newDirection == 1 and sourceLow <= zoneBottom) or (newDirection == -1 and sourceHigh >= zoneTop)
                        if invertedFilled
                            removeZone := true
                        else
                            array.set(directions, i, newDirection)
                            array.set(inversions, i, true)
                            array.set(inversionTimes, i, sourceTime)
                            newBullIfvg := newBullIfvg or newDirection == 1
                            newBearIfvg := newBearIfvg or newDirection == -1
                            newIfvgTop := zoneTop
                            newIfvgBottom := zoneBottom
                    else if filled
                        removeZone := true
                else if not removeZone
                    bool filledIfvg = (direction == 1 and sourceLow <= zoneBottom) or (direction == -1 and sourceHigh >= zoneTop)
                    if filledIfvg
                        removeZone := true

                if removeZone
                    array.remove(tops, i)
                    array.remove(bottoms, i)
                    array.remove(directions, i)
                    array.remove(inversions, i)
                    array.remove(startTimes, i)
                    array.remove(inversionTimes, i)

        bool bullCandidate = not na(sourceAtr) and sourceAtr > 0 and sourceLow > firstHigh and sourceLow - firstHigh >= sourceAtr * minWielkoscFvgAtr
        bool bearCandidate = not na(sourceAtr) and sourceAtr > 0 and sourceHigh < firstLow and firstLow - sourceHigh >= sourceAtr * minWielkoscFvgAtr
        if bullCandidate or bearCandidate
            bool bull = bullCandidate
            float zoneTop = bull ? sourceLow : firstLow
            float zoneBottom = bull ? firstHigh : sourceHigh
            array.push(tops, zoneTop)
            array.push(bottoms, zoneBottom)
            array.push(directions, bull ? 1 : -1)
            array.push(inversions, false)
            array.push(startTimes, sourceTime)
            array.push(inversionTimes, int(na))
            newBullFvg := bull
            newBearFvg := not bull
            newFvgTop := zoneTop
            newFvgBottom := zoneBottom

        while array.size(tops) > 60
            array.shift(tops)
            array.shift(bottoms)
            array.shift(directions)
            array.shift(inversions)
            array.shift(startTimes)
            array.shift(inversionTimes)

    [newBullFvg, newBearFvg, newBullIfvg, newBearIfvg, newFvgTop, newFvgBottom, newIfvgTop, newIfvgBottom]

f_draw_book(float[] tops, float[] bottoms, int[] directions, bool[] inversions, int[] startTimes, bool enabled, string tfLabel, float liveHigh, float liveLow, box[] rendered) =>
    int[] selectedAbove = array.new_int()
    int[] selectedBelow = array.new_int()
    if enabled and array.size(tops) > 0
        int ileSlotow = math.max(ileFvgNadCena, ileFvgPodCena)
        for slot = 0 to ileSlotow - 1
            int bestAbove = -1
            float bestAboveDistance = 1e20
            int newestAbove = 0
            int bestBelow = -1
            float bestBelowDistance = 1e20
            int newestBelow = 0
            for i = 0 to array.size(tops) - 1
                float zoneTop = array.get(tops, i)
                float zoneBottom = array.get(bottoms, i)
                int direction = array.get(directions, i)
                int startTime = array.get(startTimes, i)
                bool liveFilled = (direction == 1 and liveLow <= zoneBottom) or (direction == -1 and liveHigh >= zoneTop)
                bool intersects = not liveFilled and close >= zoneBottom and close <= zoneTop
                bool above = not liveFilled and (zoneBottom > close or (intersects and direction == -1))
                bool below = not liveFilled and (zoneTop < close or (intersects and direction == 1))
                float aboveDistance = above ? math.max(zoneBottom - close, 0.0) : 1e20
                float belowDistance = below ? math.max(close - zoneTop, 0.0) : 1e20
                bool betterAbove = aboveDistance < bestAboveDistance or (aboveDistance == bestAboveDistance and startTime > newestAbove)
                bool betterBelow = belowDistance < bestBelowDistance or (belowDistance == bestBelowDistance and startTime > newestBelow)
                if above and not array.includes(selectedAbove, i) and betterAbove
                    bestAbove := i
                    bestAboveDistance := aboveDistance
                    newestAbove := startTime
                if below and not array.includes(selectedBelow, i) and betterBelow
                    bestBelow := i
                    bestBelowDistance := belowDistance
                    newestBelow := startTime
            if slot < ileFvgNadCena and bestAbove >= 0
                array.push(selectedAbove, bestAbove)
            if slot < ileFvgPodCena and bestBelow >= 0
                array.push(selectedBelow, bestBelow)

    if enabled and array.size(selectedAbove) > 0
        for i = 0 to array.size(selectedAbove) - 1
            int index = array.get(selectedAbove, i)
            string zoneText = (array.get(inversions, index) ? "IFVG " : "FVG ") + tfLabel
            box zone = box.new(left = array.get(startTimes, index), top = array.get(tops, index), right = time_close, bottom = array.get(bottoms, index), xloc = xloc.bar_time, extend = extend.none, border_color = color.new(kolorStrefyFvg, 100), border_width = 0, bgcolor = color.new(kolorStrefyFvg, przezroczystoscFvg), text = zoneText, text_color = color.white, text_size = size.small, text_halign = text.align_center, text_valign = text.align_center)
            array.push(rendered, zone)
    if enabled and array.size(selectedBelow) > 0
        for i = 0 to array.size(selectedBelow) - 1
            int index = array.get(selectedBelow, i)
            string zoneText = (array.get(inversions, index) ? "IFVG " : "FVG ") + tfLabel
            box zone = box.new(left = array.get(startTimes, index), top = array.get(tops, index), right = time_close, bottom = array.get(bottoms, index), xloc = xloc.bar_time, extend = extend.none, border_color = color.new(kolorStrefyFvg, 100), border_width = 0, bgcolor = color.new(kolorStrefyFvg, przezroczystoscFvg), text = zoneText, text_color = color.white, text_size = size.small, text_halign = text.align_center, text_valign = text.align_center)
            array.push(rendered, zone)

bool matchChart = trybTfFvg == "Match chart"
string tfA = matchChart ? timeframe.period : tfAInput
string tfB = tfBInput
string tfC = tfCInput
bool useA = wlaczFvg and (matchChart or wlaczTfA)
bool useB = wlaczFvg and not matchChart and wlaczTfB and (not useA or tfB != tfA)
bool useC = wlaczFvg and not matchChart and wlaczTfC and (not useA or tfC != tfA) and (not useB or tfC != tfB)

[sourceTimeA, sourceHighA, sourceLowA, sourceCloseA, firstHighA, firstLowA, sourceAtrA] = request.security(syminfo.tickerid, tfA, [time[1], high[1], low[1], close[1], high[3], low[3], ta.atr(14)[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[sourceTimeB, sourceHighB, sourceLowB, sourceCloseB, firstHighB, firstLowB, sourceAtrB] = request.security(syminfo.tickerid, tfB, [time[1], high[1], low[1], close[1], high[3], low[3], ta.atr(14)[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[sourceTimeC, sourceHighC, sourceLowC, sourceCloseC, firstHighC, firstLowC, sourceAtrC] = request.security(syminfo.tickerid, tfC, [time[1], high[1], low[1], close[1], high[3], low[3], ta.atr(14)[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[liveHighA, liveLowA] = request.security(syminfo.tickerid, tfA, [high, low], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[liveHighB, liveLowB] = request.security(syminfo.tickerid, tfB, [high, low], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[liveHighC, liveLowC] = request.security(syminfo.tickerid, tfC, [high, low], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
int sourceMsA = int(timeframe.in_seconds(tfA) * 1000)
int sourceMsB = int(timeframe.in_seconds(tfB) * 1000)
int sourceMsC = int(timeframe.in_seconds(tfC) * 1000)

var float[] topsA = array.new_float()
var float[] bottomsA = array.new_float()
var int[] directionsA = array.new_int()
var bool[] inversionsA = array.new_bool()
var int[] startTimesA = array.new_int()
var int[] inversionTimesA = array.new_int()
var float[] topsB = array.new_float()
var float[] bottomsB = array.new_float()
var int[] directionsB = array.new_int()
var bool[] inversionsB = array.new_bool()
var int[] startTimesB = array.new_int()
var int[] inversionTimesB = array.new_int()
var float[] topsC = array.new_float()
var float[] bottomsC = array.new_float()
var int[] directionsC = array.new_int()
var bool[] inversionsC = array.new_bool()
var int[] startTimesC = array.new_int()
var int[] inversionTimesC = array.new_int()
var box[] narysowaneStrefyFvg = array.new_box()

[newBullFvgA, newBearFvgA, newBullIfvgA, newBearIfvgA, newFvgTopA, newFvgBottomA, newIfvgTopA, newIfvgBottomA] = f_update_book(topsA, bottomsA, directionsA, inversionsA, startTimesA, inversionTimesA, useA, sourceTimeA, sourceHighA, sourceLowA, sourceCloseA, firstHighA, firstLowA, sourceAtrA, sourceMsA)
[newBullFvgB, newBearFvgB, newBullIfvgB, newBearIfvgB, newFvgTopB, newFvgBottomB, newIfvgTopB, newIfvgBottomB] = f_update_book(topsB, bottomsB, directionsB, inversionsB, startTimesB, inversionTimesB, useB, sourceTimeB, sourceHighB, sourceLowB, sourceCloseB, firstHighB, firstLowB, sourceAtrB, sourceMsB)
[newBullFvgC, newBearFvgC, newBullIfvgC, newBearIfvgC, newFvgTopC, newFvgBottomC, newIfvgTopC, newIfvgBottomC] = f_update_book(topsC, bottomsC, directionsC, inversionsC, startTimesC, inversionTimesC, useC, sourceTimeC, sourceHighC, sourceLowC, sourceCloseC, firstHighC, firstLowC, sourceAtrC, sourceMsC)

if barstate.islast
    if array.size(narysowaneStrefyFvg) > 0
        for i = array.size(narysowaneStrefyFvg) - 1 to 0
            box.delete(array.get(narysowaneStrefyFvg, i))
    array.clear(narysowaneStrefyFvg)
    f_draw_book(topsA, bottomsA, directionsA, inversionsA, startTimesA, useA, f_tf_label(tfA), liveHighA, liveLowA, narysowaneStrefyFvg)
    f_draw_book(topsB, bottomsB, directionsB, inversionsB, startTimesB, useB, f_tf_label(tfB), liveHighB, liveLowB, narysowaneStrefyFvg)
    f_draw_book(topsC, bottomsC, directionsC, inversionsC, startTimesC, useC, f_tf_label(tfC), liveHighC, liveLowC, narysowaneStrefyFvg)

// ==================== KALENDARZ (CZAS WARSZAWSKI) ====================
int czasDniaWarszawa = time("D", "0000-2359:1234567", strefaCzasowaDni)
int zmianaDniaWarszawa = ta.change(czasDniaWarszawa)
bool poczatekDniaWarszawa = not na(czasDniaWarszawa) and zmianaDniaWarszawa != 0
int dzienWarszawa = dayofweek(time, strefaCzasowaDni)
int godzinaWarszawa = hour(time, strefaCzasowaDni)
int godzinaPoprzedniejSwiecyWarszawa = hour(time[1], strefaCzasowaDni)
int miesiacWarszawa = month(time, strefaCzasowaDni)
int rokWarszawa = year(time, strefaCzasowaDni)
int poprzedniMiesiacWarszawa = month(time[1], strefaCzasowaDni)
int poprzedniRokWarszawa = year(time[1], strefaCzasowaDni)
bool trybMiesiecy = timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly
bool poczatekMiesiacaWarszawa = na(time[1]) or miesiacWarszawa != poprzedniMiesiacWarszawa or rokWarszawa != poprzedniRokWarszawa
// Nazwa trafia na pierwszą świecę po lokalnym południu, czyli w środek
// odcinka wyznaczonego przez dwie kolejne północe. Działa także wtedy,
// gdy wybrany interwał nie ma świecy otwieranej dokładnie o 12:00.
bool srodekDniaWarszawa = not na(czasDniaWarszawa) and godzinaWarszawa >= 12 and (na(czasDniaWarszawa[1]) or czasDniaWarszawa != czasDniaWarszawa[1] or godzinaPoprzedniejSwiecyWarszawa < 12)

// Intraday: dzień tygodnia. D/W/M: jeden znacznik miesiąca zamiast białego paska na każdej świecy.
