[silver4Time, silver4R, silver4S, silver4TouchR, silver4TouchS] = request.security(skanerSilver, skanerTf2, f_skanuj_sfp(), lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)

var int[] skanerOstatniCzas = array.new_int(32, na)
var float[] skanerOstatniPoziom = array.new_float(32, na)

f_skan_swiezy(int slot, bool touched, int sourceTime, float level) =>
    int previousTime = array.get(skanerOstatniCzas, slot)
    float previousLevel = array.get(skanerOstatniPoziom, slot)
    bool fresh = wlaczAlerty and touched and not na(sourceTime) and not na(level) and (sourceTime != previousTime or level != previousLevel)
    if fresh
        array.set(skanerOstatniCzas, slot, sourceTime)
        array.set(skanerOstatniPoziom, slot, level)
    fresh

f_skan_payload(string market, string tf, int sourceTime) =>
    "{\"event\":\"sr_touch\",\"market\":\"" + market + "\",\"symbol\":\"" + market + "\",\"timeframe\":\"" + tf + "\",\"bar_time\":\"" + str.tostring(sourceTime) + "\"}"

if f_skan_swiezy(0, btc1TouchR, btc1Time, btc1R) or f_skan_swiezy(1, btc1TouchS, btc1Time, btc1S)
    alert(f_skan_payload("BTC", skanerTf1, btc1Time), alert.freq_all)
