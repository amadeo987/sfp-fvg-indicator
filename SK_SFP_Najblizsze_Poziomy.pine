plotshape(pokazNazweMiesiaca and miesiacWarszawa == 9, title = "Wrzesień", style = shape.labelup, location = location.bottom, color = tloNazwyDnia, text = "Wrz", textcolor = tekstNazwyDnia, size = size.tiny, display = display.pane, force_overlay = true)
plotshape(pokazNazweMiesiaca and miesiacWarszawa == 10, title = "Październik", style = shape.labelup, location = location.bottom, color = tloNazwyDnia, text = "Paź", textcolor = tekstNazwyDnia, size = size.tiny, display = display.pane, force_overlay = true)
plotshape(pokazNazweMiesiaca and miesiacWarszawa == 11, title = "Listopad", style = shape.labelup, location = location.bottom, color = tloNazwyDnia, text = "Lis", textcolor = tekstNazwyDnia, size = size.tiny, display = display.pane, force_overlay = true)
plotshape(pokazNazweMiesiaca and miesiacWarszawa == 12, title = "Grudzień", style = shape.labelup, location = location.bottom, color = tloNazwyDnia, text = "Gru", textcolor = tekstNazwyDnia, size = size.tiny, display = display.pane, force_overlay = true)

// ==================== TYLKO OSTATNI SFP RAW ====================
// RAW powstaje dopiero na zamknięciu świecy, gdy knot zamiata potwierdzony
// swing, a cały korpus wraca za poziom. To nadal setup oczekujący na CONF.
var line ostatniaRawLinia = na
var label ostatniaRawEtykieta = na
var int ostatniRawBar = na
var float ostatniRawPoziom = na
var int ostatniRawKierunek = 0  // -1 = SHORT, 1 = LONG

if bearishSetup or bullishSetup
    if not na(ostatniaRawLinia)
        line.delete(ostatniaRawLinia)
        ostatniaRawLinia := na
    if not na(ostatniaRawEtykieta)
        label.delete(ostatniaRawEtykieta)
        ostatniaRawEtykieta := na
    bool rawShort = bearishSetup
    float rawPoziom = rawShort ? bearishSetupPoziom : bullishSetupPoziom
    int rawPivotBar = rawShort ? bearishSetupPivotBar : bullishSetupPivotBar
    color rawKolor = rawShort ? kolorShort : kolorLong
    if pokazKierunkoweSfp and pokazSfpRaw
        ostatniaRawLinia := line.new(rawPivotBar, rawPoziom, bar_index, rawPoziom, xloc = xloc.bar_index, extend = extend.right, color = color.new(rawKolor, 28), style = line.style_dashed, width = 1, force_overlay = true)
        ostatniaRawEtykieta := label.new(bar_index + 1, rawPoziom, rawShort ? "SFP RAW SHORT" : "SFP RAW LONG", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.new(rawKolor, 8), size = size.tiny, force_overlay = true)
    ostatniRawBar := bar_index
    ostatniRawPoziom := rawPoziom
    ostatniRawKierunek := rawShort ? -1 : 1

if not na(ostatniRawBar) and bar_index - ostatniRawBar > waznoscRaw
    if not na(ostatniaRawLinia)
        line.delete(ostatniaRawLinia)
        ostatniaRawLinia := na
    if not na(ostatniaRawEtykieta)
        label.delete(ostatniaRawEtykieta)
        ostatniaRawEtykieta := na
    ostatniRawBar := na
    ostatniRawPoziom := na
    ostatniRawKierunek := 0

// ==================== TYLKO OSTATNI POTWIERDZONY SFP CONF ====================
var label ostatniaEtykieta = na
var int ostatniSygnalBar = na
var string ostatniSygnal = "Brak"
var float ostatniPoziom = na

if bearishSfp or bullishSfp
    if not na(ostatniaEtykieta)
        label.delete(ostatniaEtykieta)
    bool shortSignal = bearishSfp
    float poziom = shortSignal ? bearishPoziom : bullishPoziom
    int pivotBar = shortSignal ? bearishPivotBar : bullishPivotBar
    color sygnalKolor = shortSignal ? kolorShort : kolorLong
    int kierunekSygnalu = shortSignal ? -1 : 1
    // Ostatni RAW w tym samym kierunku jest poprzednikiem bieżącego CONF.
    // Nie wymagamy identycznej ceny co do ticka, bo poziom oczekującego setupu
    // może zostać znormalizowany inaczej między świecą RAW i potwierdzeniem.
    bool tenSamRaw = ostatniRawKierunek == kierunekSygnalu
    if tenSamRaw
        if not na(ostatniaRawLinia)
            line.delete(ostatniaRawLinia)
            ostatniaRawLinia := na
        if not na(ostatniaRawEtykieta)
            label.delete(ostatniaRawEtykieta)
            ostatniaRawEtykieta := na
        ostatniRawBar := na
        ostatniRawPoziom := na
        ostatniRawKierunek := 0
    if pokazOstatniSygnal
        // CONF to zdarzenie historyczne, nie poziom wejscia przy pozniejszym retescie.
        // Zostawiamy tylko krotka etykiete na swiecy potwierdzenia, bez poziomej linii.
        ostatniaEtykieta := label.new(bar_index, poziom, shortSignal ? "SFP CONF SHORT" : "SFP CONF LONG", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = sygnalKolor, size = size.tiny, force_overlay = true)
    ostatniSygnalBar := bar_index
    ostatniSygnal := shortSignal ? "Bearish / SHORT" : "Bullish / LONG"
    ostatniPoziom := poziom

if not na(ostatniSygnalBar) and bar_index - ostatniSygnalBar > waznoscSygnalu
    if not na(ostatniaEtykieta)
        label.delete(ostatniaEtykieta)
        ostatniaEtykieta := na

// ==================== PVP NAKED POC ====================
// POC jest deterministycznym przybliżeniem na podstawie OHLCV próbek.
// Skrypt nie ma dostępu do wewnętrznego, tickowego silnika PVP TradingView.
int PVP_MASK_D = 1
int PVP_MASK_W = 2
int PVP_MASK_M = 4
int PVP_MAX_LEVELS = 260
int PVP_REQUEST_BARS = 50000

var float[] pvpCeny = array.new_float()
var int[] pvpMaski = array.new_int()
var int[] pvpCzasyStart = array.new_int()
var int[] pvpCzasyPochodzenia = array.new_int()
var line[] pvpLinie = array.new_line()
var label[] pvpEtykiety = array.new_label()

f_pvp_poc(float[] highs, float[] lows, float[] volumes, float[] closes, int requestedRows) =>
    int sampleCount = array.size(highs)
    float result = na
    if sampleCount > 0
        float profileLow = array.min(lows)
        float profileHigh = array.max(highs)
        float profileRange = profileHigh - profileLow
        if profileRange <= syminfo.mintick
            result := array.get(closes, sampleCount - 1)
        else
            float rawTicksPerRow = profileRange / syminfo.mintick / requestedRows
            int ticksDown = math.max(1, int(math.floor(rawTicksPerRow)))
            int ticksUp = math.max(1, int(math.ceil(rawTicksPerRow)))
            int rowsWithDown = int(math.ceil(profileRange / (ticksDown * syminfo.mintick)))
            int rowsWithUp = int(math.ceil(profileRange / (ticksUp * syminfo.mintick)))
            int ticksPerRow = math.abs(rowsWithUp - requestedRows) <= math.abs(rowsWithDown - requestedRows) ? ticksUp : ticksDown
            float binSize = ticksPerRow * syminfo.mintick
            int bins = math.max(1, int(math.ceil(profileRange / binSize)))
            float[] histogram = array.new_float(bins, 0.0)
            for sampleIndex = 0 to sampleCount - 1
                float barHigh = array.get(highs, sampleIndex)
                float barLow = array.get(lows, sampleIndex)
                float barClose = array.get(closes, sampleIndex)
                float barVolume = nz(array.get(volumes, sampleIndex), 0.0)
                float barRange = barHigh - barLow
                if barRange <= syminfo.mintick
                    int singleBin = math.max(0, math.min(bins - 1, int(math.floor((barClose - profileLow) / binSize))))
                    array.set(histogram, singleBin, array.get(histogram, singleBin) + barVolume)
                else
                    int firstBin = math.max(0, math.min(bins - 1, int(math.floor((barLow - profileLow) / binSize))))
                    int lastBin = math.max(0, math.min(bins - 1, int(math.floor((barHigh - profileLow) / binSize))))
                    for binIndex = firstBin to lastBin
                        float binLow = profileLow + binIndex * binSize
                        float binHigh = binLow + binSize
                        float overlap = math.max(0.0, math.min(barHigh, binHigh) - math.max(barLow, binLow))
                        array.set(histogram, binIndex, array.get(histogram, binIndex) + barVolume * overlap / barRange)
            int pocBin = array.indexof(histogram, array.max(histogram))
            result := profileLow + (pocBin + 0.5) * binSize
    result

f_pvp_wyczysc_probki(float[] highs, float[] lows, float[] volumes, float[] closes) =>
    array.clear(highs)
    array.clear(lows)
    array.clear(volumes)
    array.clear(closes)

f_pvp_dodaj_probke(float[] highs, float[] lows, float[] volumes, float[] closes) =>
    array.push(highs, high)
    array.push(lows, low)
    array.push(volumes, volume)
    array.push(closes, close)

f_pvp_silnik(int rows) =>
    var float[] dHighs = array.new_float()
    var float[] dLows = array.new_float()
    var float[] dVolumes = array.new_float()
    var float[] dCloses = array.new_float()
    var float[] wHighs = array.new_float()
    var float[] wLows = array.new_float()
    var float[] wVolumes = array.new_float()
    var float[] wCloses = array.new_float()
    var float[] mHighs = array.new_float()
    var float[] mLows = array.new_float()
    var float[] mVolumes = array.new_float()
    var float[] mCloses = array.new_float()
    var float dailyPoc = na
    var float weeklyPoc = na
    var float monthlyPoc = na
    var int dailyEvent = na
    var int weeklyEvent = na
    var int monthlyEvent = na
    var int dailyOrigin = na
    var int weeklyOrigin = na
    var int monthlyOrigin = na
    if timeframe.change("D")
        if array.size(dHighs) > 0
            dailyPoc := f_pvp_poc(dHighs, dLows, dVolumes, dCloses, rows)
            dailyEvent := time
            dailyOrigin := time("D")[1]
        f_pvp_wyczysc_probki(dHighs, dLows, dVolumes, dCloses)
    if timeframe.change("W")
        if array.size(wHighs) > 0
            weeklyPoc := f_pvp_poc(wHighs, wLows, wVolumes, wCloses, rows)
            weeklyEvent := time
            weeklyOrigin := time("W")[1]
        f_pvp_wyczysc_probki(wHighs, wLows, wVolumes, wCloses)
    if timeframe.change("M")
        if array.size(mHighs) > 0
            monthlyPoc := f_pvp_poc(mHighs, mLows, mVolumes, mCloses, rows)
            monthlyEvent := time
            monthlyOrigin := time("M")[1]
        f_pvp_wyczysc_probki(mHighs, mLows, mVolumes, mCloses)
    f_pvp_dodaj_probke(dHighs, dLows, dVolumes, dCloses)
    f_pvp_dodaj_probke(wHighs, wLows, wVolumes, wCloses)
    f_pvp_dodaj_probke(mHighs, mLows, mVolumes, mCloses)
    [dailyPoc, dailyEvent, weeklyPoc, weeklyEvent, monthlyPoc, monthlyEvent, high, low, time, barstate.isconfirmed, dailyOrigin, weeklyOrigin, monthlyOrigin]

f_pvp_ma_maske(int mask, int flag) =>
    mask % (flag * 2) >= flag

f_pvp_tekst(int mask) =>
    mask == PVP_MASK_D ? "ndPOC" : mask == PVP_MASK_W ? "nwPOC" : "nmPOC"

f_pvp_kolor(int mask) =>
    mask == PVP_MASK_D ? pvpKolorD : mask == PVP_MASK_W ? pvpKolorW : pvpKolorM

f_pvp_usun(int index) =>
    line oldLine = array.get(pvpLinie, index)
    label oldLabel = array.get(pvpEtykiety, index)
    if not na(oldLine)
        line.delete(oldLine)
    if not na(oldLabel)
        label.delete(oldLabel)
    array.remove(pvpCeny, index)
    array.remove(pvpMaski, index)
    array.remove(pvpCzasyStart, index)
    array.remove(pvpCzasyPochodzenia, index)
    array.remove(pvpLinie, index)
    array.remove(pvpEtykiety, index)

f_pvp_przytnij() =>
    while array.size(pvpCeny) > PVP_MAX_LEVELS
        int farthestIndex = 0
        float farthestDistance = -1.0
        for index = 0 to array.size(pvpCeny) - 1
            float distance = math.abs(array.get(pvpCeny, index) - close)
            if distance > farthestDistance
                farthestDistance := distance
                farthestIndex := index
        f_pvp_usun(farthestIndex)

f_pvp_dodaj_poziom(float poc, int eventTime, int originTime, int mask, bool enabled) =>
    if pokazPvp and enabled and not na(poc) and not na(eventTime) and not na(originTime)
        array.push(pvpCeny, poc)
        array.push(pvpMaski, mask)
        array.push(pvpCzasyStart, eventTime)
        array.push(pvpCzasyPochodzenia, originTime)
        array.push(pvpLinie, na)
        array.push(pvpEtykiety, na)
        f_pvp_przytnij()

f_pvp_dotkniecia(float sourceHigh, float sourceLow, int sourceTime) =>
    if array.size(pvpCeny) > 0
        for index = array.size(pvpCeny) - 1 to 0
            float levelPrice = array.get(pvpCeny, index)
            int startTime = array.get(pvpCzasyStart, index)
            if sourceTime >= startTime and sourceLow <= levelPrice and sourceHigh >= levelPrice
                f_pvp_usun(index)

f_pvp_przetworz(float dPoc, int dEvent, float wPoc, int wEvent, float mPoc, int mEvent, float sourceHigh, float sourceLow, int sourceTime, bool sourceConfirmed, int prevD, int prevW, int prevM, int dOrigin, int wOrigin, int mOrigin) =>
    int nextD = prevD
    int nextW = prevW
    int nextM = prevM
    if sourceConfirmed
        if not na(dEvent) and (na(nextD) or dEvent != nextD)
            f_pvp_dodaj_poziom(dPoc, dEvent, dOrigin, PVP_MASK_D, pvpPokazD)
            nextD := dEvent
        if not na(wEvent) and (na(nextW) or wEvent != nextW)
            f_pvp_dodaj_poziom(wPoc, wEvent, wOrigin, PVP_MASK_W, pvpPokazW)
            nextW := wEvent
        if not na(mEvent) and (na(nextM) or mEvent != nextM)
            f_pvp_dodaj_poziom(mPoc, mEvent, mOrigin, PVP_MASK_M, pvpPokazM)
            nextM := mEvent
        f_pvp_dotkniecia(sourceHigh, sourceLow, sourceTime)
    [nextD, nextW, nextM]

var int pvpOstatniD = na
var int pvpOstatniW = na
var int pvpOstatniM = na
var int pvpOstatniCzasProbki = na

bool pvpUzyjTablicIntrabar = timeframe.in_seconds() > timeframe.in_seconds(pvpTfProbek)
if pokazPvp and pvpUzyjTablicIntrabar
    [pvpDPocs, pvpDEvents, pvpWPocs, pvpWEvents, pvpMPocs, pvpMEvents, pvpHighs, pvpLows, pvpTimes, pvpConfirmed, pvpDOrigins, pvpWOrigins, pvpMOrigins] = request.security_lower_tf(syminfo.tickerid, pvpTfProbek, f_pvp_silnik(pvpLiczbaRzedow), ignore_invalid_timeframe = true, calc_bars_count = PVP_REQUEST_BARS)
    if array.size(pvpTimes) > 0
        for sourceIndex = 0 to array.size(pvpTimes) - 1
            [nextD, nextW, nextM] = f_pvp_przetworz(array.get(pvpDPocs, sourceIndex), array.get(pvpDEvents, sourceIndex), array.get(pvpWPocs, sourceIndex), array.get(pvpWEvents, sourceIndex), array.get(pvpMPocs, sourceIndex), array.get(pvpMEvents, sourceIndex), array.get(pvpHighs, sourceIndex), array.get(pvpLows, sourceIndex), array.get(pvpTimes, sourceIndex), array.get(pvpConfirmed, sourceIndex), pvpOstatniD, pvpOstatniW, pvpOstatniM, array.get(pvpDOrigins, sourceIndex), array.get(pvpWOrigins, sourceIndex), array.get(pvpMOrigins, sourceIndex))
            pvpOstatniD := nextD
            pvpOstatniW := nextW
            pvpOstatniM := nextM
else if pokazPvp
    [pvpDPoc, pvpDEvent, pvpWPoc, pvpWEvent, pvpMPoc, pvpMEvent, pvpSourceHigh, pvpSourceLow, pvpSourceTime, pvpSourceConfirmed, pvpDOrigin, pvpWOrigin, pvpMOrigin] = request.security(syminfo.tickerid, pvpTfProbek, f_pvp_silnik(pvpLiczbaRzedow), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = PVP_REQUEST_BARS)
    if not na(pvpSourceTime) and (na(pvpOstatniCzasProbki) or pvpSourceTime != pvpOstatniCzasProbki)
        [nextD, nextW, nextM] = f_pvp_przetworz(pvpDPoc, pvpDEvent, pvpWPoc, pvpWEvent, pvpMPoc, pvpMEvent, pvpSourceHigh, pvpSourceLow, pvpSourceTime, pvpSourceConfirmed, pvpOstatniD, pvpOstatniW, pvpOstatniM, pvpDOrigin, pvpWOrigin, pvpMOrigin)
        pvpOstatniD := nextD
        pvpOstatniW := nextW
        pvpOstatniM := nextM
        pvpOstatniCzasProbki := pvpSourceTime

int pvpLabelIndex = bar_index + pvpPrzesuniecieEtykiet
if barstate.islast and array.size(pvpCeny) > 0
    for index = 0 to array.size(pvpCeny) - 1
        float levelPrice = array.get(pvpCeny, index)
        int levelMask = array.get(pvpMaski, index)
        float ownDistance = math.abs(levelPrice - close)
        int closerD = 0
        int closerW = 0
        int closerM = 0
        for otherIndex = 0 to array.size(pvpCeny) - 1
            if otherIndex != index and math.abs(array.get(pvpCeny, otherIndex) - close) < ownDistance
                int otherMask = array.get(pvpMaski, otherIndex)
                closerD += f_pvp_ma_maske(otherMask, PVP_MASK_D) ? 1 : 0
                closerW += f_pvp_ma_maske(otherMask, PVP_MASK_W) ? 1 : 0
                closerM += f_pvp_ma_maske(otherMask, PVP_MASK_M) ? 1 : 0
        bool shouldShow = (f_pvp_ma_maske(levelMask, PVP_MASK_D) and closerD < pvpNajblizszeD) or (f_pvp_ma_maske(levelMask, PVP_MASK_W) and closerW < pvpNajblizszeW) or (f_pvp_ma_maske(levelMask, PVP_MASK_M) and closerM < pvpNajblizszeM)
        line currentLine = array.get(pvpLinie, index)
        label currentLabel = array.get(pvpEtykiety, index)
        if shouldShow
            color drawColor = f_pvp_kolor(levelMask)
            int futureMs = int(nz(timeframe.in_seconds(), 86400) * 1000) * (pvpPrzesuniecieEtykiet + 500)
            int lineSecondTime = time_close + futureMs
            int lineOriginTime = array.get(pvpCzasyPochodzenia, index)
            if na(currentLine)
                currentLine := line.new(lineOriginTime, levelPrice, lineSecondTime, levelPrice, xloc = xloc.bar_time, extend = extend.right, color = drawColor, width = 1, force_overlay = true)
                array.set(pvpLinie, index, currentLine)
            else
                line.set_xy1(currentLine, lineOriginTime, levelPrice)
                line.set_xy2(currentLine, lineSecondTime, levelPrice)
                line.set_color(currentLine, drawColor)
                line.set_width(currentLine, 1)
                line.set_extend(currentLine, extend.right)
            if pvpPokazEtykiety
                string labelText = f_pvp_tekst(levelMask)
                if na(currentLabel)
                    currentLabel := label.new(pvpLabelIndex, levelPrice, labelText, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_right, color = chart.bg_color, textcolor = drawColor, size = size.tiny, textalign = text.align_right, force_overlay = true)
                    array.set(pvpEtykiety, index, currentLabel)
                else
                    label.set_xy(currentLabel, pvpLabelIndex, levelPrice)
                    label.set_text(currentLabel, labelText)
                    label.set_color(currentLabel, chart.bg_color)
                    label.set_textcolor(currentLabel, drawColor)
            else if not na(currentLabel)
                label.delete(currentLabel)
                array.set(pvpEtykiety, index, na)
        else
            if not na(currentLine)
                line.delete(currentLine)
                array.set(pvpLinie, index, na)
            if not na(currentLabel)
                label.delete(currentLabel)
                array.set(pvpEtykiety, index, na)

// ==================== WATERMARK ====================
