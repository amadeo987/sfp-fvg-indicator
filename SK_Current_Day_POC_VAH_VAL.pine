// [SK] Current Day POC / VAH / VAL v1.0
// Developing current-session profile built from visible chart bars. Values are
// approximate because Pine scripts do not receive TradingView's internal
// tick-by-tick Volume Profile bins.

//@version=6
indicator("[SK] Current Day POC / VAH / VAL v1.0", shorttitle = "SK DAY VP", overlay = true, max_lines_count = 10, max_labels_count = 10)

string groupProfile = "Current day profile"
string profileTimezone = input.string("Etc/UTC", "Profile timezone", options = ["Etc/UTC", "Europe/Warsaw", "America/New_York", "exchange"], group = groupProfile)
string profileSession = input.session("0000-2359:1234567", "Profile session", group = groupProfile, tooltip = "Default is the full UTC day, suitable for 24/7 crypto. Choose exchange timezone and adjust the session for other markets.")
int rows = input.int(48, "Price rows", minval = 24, maxval = 100, group = groupProfile)
float valueAreaPercent = input.float(70.0, "Value area percent", minval = 50.0, maxval = 99.0, step = 1.0, group = groupProfile)
int maximumStoredBars = input.int(2000, "Maximum stored intraday bars", minval = 250, maxval = 5000, group = groupProfile)
bool showLabels = input.bool(true, "Show labels", group = groupProfile)

string timezone = profileTimezone == "exchange" ? syminfo.timezone : profileTimezone
int sessionTime = time(timeframe.period, profileSession, timezone)
int profileDay = time("D", profileSession, timezone)
bool inSession = timeframe.isintraday and not na(sessionTime)
int profileDayChange = ta.change(profileDay)
bool newProfileDay = not na(profileDay) and profileDayChange != 0

var int[] storedTimes = array.new_int()
var float[] storedHighs = array.new_float()
var float[] storedLows = array.new_float()
var float[] storedVolumes = array.new_float()

if newProfileDay
    array.clear(storedTimes)
    array.clear(storedHighs)
    array.clear(storedLows)
    array.clear(storedVolumes)

if inSession
    bool newStoredBar = array.size(storedTimes) == 0 or array.get(storedTimes, array.size(storedTimes) - 1) != time
    if newStoredBar
        array.push(storedTimes, time)
        array.push(storedHighs, high)
        array.push(storedLows, low)
        array.push(storedVolumes, nz(volume))
    else
        int lastIndex = array.size(storedTimes) - 1
        array.set(storedHighs, lastIndex, high)
        array.set(storedLows, lastIndex, low)
        array.set(storedVolumes, lastIndex, nz(volume))

while array.size(storedTimes) > maximumStoredBars
    array.shift(storedTimes)
    array.shift(storedHighs)
    array.shift(storedLows)
    array.shift(storedVolumes)

var line pocLine = na
var line vahLine = na
var line valLine = na
var label pocLabel = na
var label vahLabel = na
var label valLabel = na
var label warningLabel = na
var float currentPoc = na
var float currentVah = na
var float currentVal = na

f_delete_drawings() =>
    if not na(pocLine)
        line.delete(pocLine)
    if not na(vahLine)
        line.delete(vahLine)
    if not na(valLine)
        line.delete(valLine)
    if not na(pocLabel)
        label.delete(pocLabel)
    if not na(vahLabel)
        label.delete(vahLabel)
    if not na(valLabel)
        label.delete(valLabel)
    if not na(warningLabel)
        label.delete(warningLabel)

if barstate.islast
    f_delete_drawings()
    pocLine := na
    vahLine := na
    valLine := na
    pocLabel := na
    vahLabel := na
    valLabel := na
    warningLabel := na
    currentPoc := na
    currentVah := na
    currentVal := na

    if not timeframe.isintraday
        warningLabel := label.new(bar_index, high, "Current Day Profile requires an intraday chart", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = color.new(color.red, 72), textcolor = color.white, size = size.small)
    else if array.size(storedTimes) > 0
        float profileLow = array.min(storedLows)
        float profileHigh = array.max(storedHighs)
        float profileRange = profileHigh - profileLow
        if profileRange > 0
            float rowHeight = profileRange / rows
            float[] rowVolumes = array.new_float(rows, 0.0)
            float totalVolume = 0.0

            for i = 0 to array.size(storedTimes) - 1
                float barHigh = array.get(storedHighs, i)
                float barLow = array.get(storedLows, i)
                float barVolume = array.get(storedVolumes, i)
                totalVolume += barVolume
                if barHigh > barLow
                    int firstRow = math.max(0, math.min(rows - 1, int(math.floor((barLow - profileLow) / rowHeight))))
                    int lastRow = math.max(0, math.min(rows - 1, int(math.floor((barHigh - profileLow) / rowHeight))))
                    for row = firstRow to lastRow
                        float rowBottom = profileLow + row * rowHeight
                        float rowTop = rowBottom + rowHeight
                        float overlap = math.max(0.0, math.min(barHigh, rowTop) - math.max(barLow, rowBottom))
                        if overlap > 0
                            array.set(rowVolumes, row, array.get(rowVolumes, row) + barVolume * overlap / (barHigh - barLow))
                else
                    int row = math.max(0, math.min(rows - 1, int(math.floor((barLow - profileLow) / rowHeight))))
                    array.set(rowVolumes, row, array.get(rowVolumes, row) + barVolume)

            if totalVolume > 0
                int pocIndex = array.indexof(rowVolumes, array.max(rowVolumes))
                int valueAreaLowIndex = pocIndex
                int valueAreaHighIndex = pocIndex
                float includedVolume = array.get(rowVolumes, pocIndex)
                float targetVolume = totalVolume * valueAreaPercent / 100.0

                while includedVolume < targetVolume and (valueAreaLowIndex > 0 or valueAreaHighIndex < rows - 1)
                    float volumeAbove = valueAreaHighIndex < rows - 1 ? array.get(rowVolumes, valueAreaHighIndex + 1) : -1.0
                    float volumeBelow = valueAreaLowIndex > 0 ? array.get(rowVolumes, valueAreaLowIndex - 1) : -1.0
                    if volumeAbove >= volumeBelow
                        valueAreaHighIndex += 1
                        includedVolume += math.max(volumeAbove, 0.0)
                    else
                        valueAreaLowIndex -= 1
                        includedVolume += math.max(volumeBelow, 0.0)

                currentPoc := profileLow + (pocIndex + 0.5) * rowHeight
                currentVah := profileLow + (valueAreaHighIndex + 1.0) * rowHeight
                currentVal := profileLow + valueAreaLowIndex * rowHeight
                int leftTime = array.get(storedTimes, 0)
                pocLine := line.new(leftTime, currentPoc, time_close, currentPoc, xloc = xloc.bar_time, extend = extend.right, color = color.rgb(255, 193, 7), width = 3)
                vahLine := line.new(leftTime, currentVah, time_close, currentVah, xloc = xloc.bar_time, extend = extend.right, color = color.rgb(239, 83, 80), width = 1, style = line.style_dashed)
                valLine := line.new(leftTime, currentVal, time_close, currentVal, xloc = xloc.bar_time, extend = extend.right, color = color.rgb(38, 166, 154), width = 1, style = line.style_dashed)
                if showLabels
                    pocLabel := label.new(bar_index + 1, currentPoc, "POC " + str.tostring(currentPoc, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(color.rgb(255, 193, 7), 78), textcolor = color.rgb(255, 193, 7), size = size.tiny)
                    vahLabel := label.new(bar_index + 1, currentVah, "VAH " + str.tostring(currentVah, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(color.rgb(239, 83, 80), 78), textcolor = color.rgb(239, 83, 80), size = size.tiny)
                    valLabel := label.new(bar_index + 1, currentVal, "VAL " + str.tostring(currentVal, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(color.rgb(38, 166, 154), 78), textcolor = color.rgb(38, 166, 154), size = size.tiny)

plot(currentPoc, "Developing POC", color = color.new(color.rgb(255, 193, 7), 100), display = display.data_window)
plot(currentVah, "Developing VAH", color = color.new(color.rgb(239, 83, 80), 100), display = display.data_window)
plot(currentVal, "Developing VAL", color = color.new(color.rgb(38, 166, 154), 100), display = display.data_window)
