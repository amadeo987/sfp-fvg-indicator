// [SK] S/R Telegram Scanner v1.1
// Monitors confirmed pivot support/resistance on BTC and ETH perpetuals from OKX
// and the HYPE perpetual from Hyperliquid. It never places orders.

//@version=6
indicator("[SK] S/R Telegram Scanner v1.1", shorttitle = "SK SR Scan", overlay = true, dynamic_requests = true)

string groupMarkets = "Markets"
string groupTimeframes = "Timeframes"
string groupDetection = "Detection"
string groupAlerts = "Alerts"

bool useBtc = input.bool(true, "BTC on OKX", inline = "btc", group = groupMarkets)
string symbolBtc = input.symbol("OKX:BTCUSDT.P", "", inline = "btc", group = groupMarkets)
bool useEth = input.bool(true, "ETH on OKX", inline = "eth", group = groupMarkets)
string symbolEth = input.symbol("OKX:ETHUSDT.P", "", inline = "eth", group = groupMarkets)
bool useHype = input.bool(true, "HYPE on Hyperliquid", inline = "hype", group = groupMarkets)
string symbolHype = input.symbol("Hyperliquid:HYPEUSDC.P", "", inline = "hype", group = groupMarkets)

string tf1 = input.timeframe("60", "Timeframe 1", inline = "tfs", group = groupTimeframes)
string tf2 = input.timeframe("240", "Timeframe 2", inline = "tfs", group = groupTimeframes)

int pivotLeft = input.int(5, "Pivot bars left", minval = 2, maxval = 20, group = groupDetection)
int pivotRight = input.int(5, "Pivot bars right", minval = 2, maxval = 20, group = groupDetection, tooltip = "A level becomes available only after this many source-timeframe bars confirm the pivot.")
int sourceMemory = input.int(6, "Confirmed pivots checked per side", minval = 2, maxval = 6, group = groupDetection)
float tolerancePct = input.float(0.05, "Touch tolerance (%)", minval = 0.0, maxval = 1.0, step = 0.01, group = groupDetection, tooltip = "A touch is detected when the source candle overlaps this percentage band around a confirmed level.")

bool enableAlerts = input.bool(true, "Enable alert() events", group = groupAlerts, tooltip = "Create one TradingView alert using 'Any alert() function call'. Run the scanner on a 1H or lower chart so 1H touches are not skipped.")

f_nearest_resistance(float reference, float p0, float p1, float p2, float p3, float p4, float p5, int count) =>
    float nearest = na
    float[] candidates = array.from(p0, p1, p2, p3, p4, p5)
    for i = 0 to count - 1
        float candidate = array.get(candidates, i)
        if not na(candidate) and candidate > reference and (na(nearest) or candidate < nearest)
            nearest := candidate
    nearest

f_nearest_support(float reference, float p0, float p1, float p2, float p3, float p4, float p5, int count) =>
    float nearest = na
    float[] candidates = array.from(p0, p1, p2, p3, p4, p5)
    for i = 0 to count - 1
        float candidate = array.get(candidates, i)
        if not na(candidate) and candidate < reference and (na(nearest) or candidate > nearest)
            nearest := candidate
    nearest

f_scan() =>
    float pivotHigh = ta.pivothigh(high, pivotLeft, pivotRight)
    float pivotLow = ta.pivotlow(low, pivotLeft, pivotRight)
    float h0 = ta.valuewhen(not na(pivotHigh), pivotHigh, 0)[1]
    float h1 = ta.valuewhen(not na(pivotHigh), pivotHigh, 1)[1]
    float h2 = ta.valuewhen(not na(pivotHigh), pivotHigh, 2)[1]
    float h3 = ta.valuewhen(not na(pivotHigh), pivotHigh, 3)[1]
    float h4 = ta.valuewhen(not na(pivotHigh), pivotHigh, 4)[1]
    float h5 = ta.valuewhen(not na(pivotHigh), pivotHigh, 5)[1]
    float l0 = ta.valuewhen(not na(pivotLow), pivotLow, 0)[1]
    float l1 = ta.valuewhen(not na(pivotLow), pivotLow, 1)[1]
    float l2 = ta.valuewhen(not na(pivotLow), pivotLow, 2)[1]
    float l3 = ta.valuewhen(not na(pivotLow), pivotLow, 3)[1]
    float l4 = ta.valuewhen(not na(pivotLow), pivotLow, 4)[1]
    float l5 = ta.valuewhen(not na(pivotLow), pivotLow, 5)[1]
    float reference = close[1]
    float resistance = f_nearest_resistance(reference, h0, h1, h2, h3, h4, h5, sourceMemory)
    float support = f_nearest_support(reference, l0, l1, l2, l3, l4, l5, sourceMemory)
    float tolerance = tolerancePct / 100.0
    bool touchingResistance = not na(resistance) and high >= resistance * (1.0 - tolerance) and low <= resistance * (1.0 + tolerance)
    bool touchingSupport = not na(support) and high >= support * (1.0 - tolerance) and low <= support * (1.0 + tolerance)
    bool newResistanceTouch = touchingResistance and not touchingResistance[1]
    bool newSupportTouch = touchingSupport and not touchingSupport[1]
    [close, time, resistance, support, newResistanceTouch, newSupportTouch]

[btc1Price, btc1Time, btc1R, btc1S, btc1TouchR, btc1TouchS] = request.security(symbolBtc, tf1, f_scan(), lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
[btc2Price, btc2Time, btc2R, btc2S, btc2TouchR, btc2TouchS] = request.security(symbolBtc, tf2, f_scan(), lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
[eth1Price, eth1Time, eth1R, eth1S, eth1TouchR, eth1TouchS] = request.security(symbolEth, tf1, f_scan(), lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
[eth2Price, eth2Time, eth2R, eth2S, eth2TouchR, eth2TouchS] = request.security(symbolEth, tf2, f_scan(), lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
[hype1Price, hype1Time, hype1R, hype1S, hype1TouchR, hype1TouchS] = request.security(symbolHype, tf1, f_scan(), lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
[hype2Price, hype2Time, hype2R, hype2S, hype2TouchR, hype2TouchS] = request.security(symbolHype, tf2, f_scan(), lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)

var int[] lastAlertTime = array.new_int(12, na)
var float[] lastAlertLevel = array.new_float(12, na)

f_fresh(int slot, bool enabled, bool touched, int sourceTime, float level) =>
    int previousTime = array.get(lastAlertTime, slot)
    float previousLevel = array.get(lastAlertLevel, slot)
    bool fresh = enableAlerts and enabled and touched and not na(sourceTime) and not na(level) and (sourceTime != previousTime or level != previousLevel)
    if fresh
        array.set(lastAlertTime, slot, sourceTime)
        array.set(lastAlertLevel, slot, level)
    fresh

f_payload(string symbol, string tf, string side, float level, float price, int sourceTime) =>
    float distancePct = not na(price) and not na(level) and level != 0.0 ? math.abs(price - level) / level * 100.0 : na
    "{\"event\":\"sr_touch\",\"symbol\":\"" + symbol + "\",\"timeframe\":\"" + tf + "\",\"side\":\"" + side + "\",\"level\":\"" + str.tostring(level, "#.########") + "\",\"price\":\"" + str.tostring(price, "#.########") + "\",\"distance_pct\":\"" + str.tostring(distancePct, "#.###") + "\",\"bar_time\":\"" + str.tostring(sourceTime) + "\"}"

if f_fresh(0, useBtc, btc1TouchR, btc1Time, btc1R)
    alert(f_payload(symbolBtc, tf1, "RESISTANCE", btc1R, btc1Price, btc1Time), alert.freq_all)
if f_fresh(1, useBtc, btc1TouchS, btc1Time, btc1S)
    alert(f_payload(symbolBtc, tf1, "SUPPORT", btc1S, btc1Price, btc1Time), alert.freq_all)
if f_fresh(2, useBtc, btc2TouchR, btc2Time, btc2R)
    alert(f_payload(symbolBtc, tf2, "RESISTANCE", btc2R, btc2Price, btc2Time), alert.freq_all)
if f_fresh(3, useBtc, btc2TouchS, btc2Time, btc2S)
    alert(f_payload(symbolBtc, tf2, "SUPPORT", btc2S, btc2Price, btc2Time), alert.freq_all)
if f_fresh(4, useEth, eth1TouchR, eth1Time, eth1R)
    alert(f_payload(symbolEth, tf1, "RESISTANCE", eth1R, eth1Price, eth1Time), alert.freq_all)
if f_fresh(5, useEth, eth1TouchS, eth1Time, eth1S)
    alert(f_payload(symbolEth, tf1, "SUPPORT", eth1S, eth1Price, eth1Time), alert.freq_all)
if f_fresh(6, useEth, eth2TouchR, eth2Time, eth2R)
    alert(f_payload(symbolEth, tf2, "RESISTANCE", eth2R, eth2Price, eth2Time), alert.freq_all)
if f_fresh(7, useEth, eth2TouchS, eth2Time, eth2S)
    alert(f_payload(symbolEth, tf2, "SUPPORT", eth2S, eth2Price, eth2Time), alert.freq_all)
if f_fresh(8, useHype, hype1TouchR, hype1Time, hype1R)
    alert(f_payload(symbolHype, tf1, "RESISTANCE", hype1R, hype1Price, hype1Time), alert.freq_all)
if f_fresh(9, useHype, hype1TouchS, hype1Time, hype1S)
    alert(f_payload(symbolHype, tf1, "SUPPORT", hype1S, hype1Price, hype1Time), alert.freq_all)
if f_fresh(10, useHype, hype2TouchR, hype2Time, hype2R)
    alert(f_payload(symbolHype, tf2, "RESISTANCE", hype2R, hype2Price, hype2Time), alert.freq_all)
if f_fresh(11, useHype, hype2TouchS, hype2Time, hype2S)
    alert(f_payload(symbolHype, tf2, "SUPPORT", hype2S, hype2Price, hype2Time), alert.freq_all)
